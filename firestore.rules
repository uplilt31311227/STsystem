rules_version = '2';

// STsystem V2 權限系統 Firestore 規則（v2.20（代課改雙簽：教師發起代課須經代課教師同意才進核准佇列）、v2.19（P10 code-review：config 通用主任規則排除 recordsLock 與 grade9，兩者只走專屬規則）、v2.18（LC-L7／LF-M8：紀錄與申請的學期歸屬改依日期推算，寫入窗口放寬為目前學期＋相鄰學期）、v2.17（P9 批次 A2：初始主任白名單在學校有正式主任後失效、platformAdmin 為全系統最高管理員、核准者職務分離）、v2.16（P9 批次 A：組長改教師檔欄位白名單、主任不可刪自己的教師檔、approver／發起人可刪 private/detail）、v2.15（P7：config/settlement 增加逐人超鐘點門檻欄位、config/grade9 九年級畢業設定）、v2.14（含 v2.13-A／B、v2.14 成立紀錄序號鎖，皆已納入本檔，P5／P6 未部署）— 身分與授權修補 + 三層角色 + 敏感欄位私有化 + 學期唯讀鎖 + 封存生命週期 + schoolId 反查目錄 + 多租戶開通 + 月結算設定開放 approver + 主任不可改自己的 role + 課表匯入版本紀錄 + 組長可刪除目前學期紀錄 + 開新學期原子建立課表 + 課表版本號）
//
// 設計原則：
//   1. 兩條根路徑物理隔離
//      - schools/{schoolId}/...  ← V2 全校共用資料
//      - users/{uid}/...         ← 穩定版 master 個人空間（保留原規則）
//   2. V2 角色三層
//      - director（教務主任）：最高權限 + 後台教師管理 + 學校設定
//      - section_chief（教學組長）：核准 / 駁回 / 上傳課表 / 月結算 / 查看所有紀錄與日誌
//      - teacher（一般教師）：看全校課表唯讀 + 申請自己代調課 + 回應對調 + 查自己相關紀錄
//   3. 舊 v2 alpha 期 teacher.role == 'admin' 仍兼容：在 rules 中視同 director。
//      config.initialAdminEmails 欄位名稱維持，意義改為「初始主任白名單」。
//   4. 寫入規則對齊應用層 pendingRequestService / authGuardV2 / teacherAccountManager 行為。
//   5. Phase 6（2026-07-29）：substituteRecords / pendingRequests 底下新增 private/detail
//      子文件，存放 leaveType/leaveTypeName/reason（原本任何登入教師皆可讀，屬敏感個資）。
//      父文件不再寫入這三個欄位；private 文件自帶 allowedTeacherIds 清單（建立時由應用層
//      算好寫入），規則不需 get() 父文件即可判斷可讀性。舊資料的三欄位仍留在父文件上，
//      相容讀取由應用層處理（rules 對父文件的欄位不做限制，不需特別相容）。
//   6. Stage 2（2026-07-31，RESEARCH-multitenancy-semester.md §5/§6.1；驗收修復見下）：
//      學期成為一級概念。課表從單一文件 data/schedule 改為 per-semester 文件
//      schedules/{semesterId}；substituteRecords/pendingRequests 新寫入一律帶 semesterId，
//      且鎖定只能寫「目前作用中的學期」（config.currentSemester）。
//      歷史學期唯讀的實際涵蓋範圍（如實描述，不是「加了鎖」這種籠統說法）：
//        - substituteRecords 的 create：鎖 semesterId==目前學期，legacyMigrationService 的
//          一次性歷史遷移經 isDeclaredLegacyWrite() 豁免（限 director + migratedFrom 欄位
//          存在 + semesterId 為字串，見該函式定義處，阻斷 1 修復）。
//        - substituteRecords 的 update：鎖「semesterId 不可變」+「該紀錄目前所屬學期須仍是
//          作用中學期」兩項——後者是阻斷 2 修復新增的，原版只鎖了前者，歷史紀錄的其他欄位
//          （日期/教師/節次等）在修復前仍可被 approver 任意編輯，不算真正唯讀。
//        - substituteRecords/{id}/private/detail 的 update：同步鎖（讀父文件判斷，阻斷 2）。
//        - pendingRequests 的 create：鎖 semesterId==目前學期（超出報告 §6.1 明文只提
//          substituteRecords 的範圍，本次實作 prompt 明確要求兩者都鎖）；update 未鎖（維持
//          報告原意——在途申請本來就該在核准/駁回/撤回後結案，不特別加鎖）。
//        - schedules/{semesterId} 的 write：鎖只能寫目前學期那一份文件。
//      新 rules＋舊 client 過渡窗口：舊 client 送出不含 semesterId 的寫入會被
//      `'semesterId' in request.resource.data` 顯式檔下（中 6 修復），此窗口內全校無法新增
//      紀錄/申請，見 docs/STAGE0-DEPLOY.md「附註：Stage 2」。
//      舊資料回填前（scripts/backfill-semester-id.js 尚未執行）的相容處理：create 規則不受
//      影響（新寫入本來就一律由程式碼蓋 semesterId）；update 規則見
//      `!('semesterId' in resource.data)` 短路豁免（讓回填前的舊文件仍可正常編輯）。
//      ⚠ 驗收修復（R6，opus 重驗）：如實記錄信任邊界——學期唯讀鎖對 director 不構成實質
//      約束。isDeclaredLegacyWrite() 只要求 isDirector(schoolId) 成立即豁免整條學期鎖；
//      config.currentSemester 本身也只有 director 能改（見 config/{docId} 的 write 規則）。
//      一個惡意或被入侵的 director 帳號，理論上可以把任意寫入宣告成 isLegacy 繞過鎖、或
//      直接把 currentSemester 改成任意值再寫入。這不是本次新增的破口——與系統既有的其他
//      director-only 破壞性操作（刪除任何紀錄、刪除教師、清除所有資料）同一信任層級，只是
//      這裡第一次被明確寫下來，避免日後誤以為「學期鎖」對所有角色（含 director）一視同仁。
//   7. Stage 5（2026-07-31，RESEARCH-multitenancy-semester.md §6.2/§6.5；封存與生命週期工具）：
//      新增 archives/{semesterId}（封存紀錄，create-only + 不可改/刪，同 operationLogs 精神）；
//      schedules/{semesterId} 的 write 拆成 create/update（維持原「僅目前學期」鎖）+ delete
//      （新增，director 專用，且僅能刪「非目前學期」——供封存流程刪除歷史學期課表用）。
//      substituteRecords/pendingRequests 的既有 delete 規則（director-only／
//      approver-or-initiator，皆無學期鎖）未變動，封存流程直接沿用；operationLogs 的
//      「不可改/刪」規則同樣未變動——期滿清理改由平台管理者離線以 gcloud/REST owner 憑證執行
//      （不受 client Security Rules 限制），見 scripts/cleanup-operation-logs.js 檔頭說明。
//   8. Stage 3（2026-07-31，RESEARCH-multitenancy-semester.md §4 集合設計預告／§8 Stage 3；
//      SCHOOL_ID 動態化）：新增頂層（不在 schools/{schoolId} 之下）集合 userDirectory/{uid}，
//      供登入後「反查這個 uid 屬於哪所學校」——純前端在不知道 schoolId 之前無法組出
//      schools/{schoolId}/... 路徑，也無法用 exists()/get() 判斷成員資格，故這份文件必須是
//      頂層、且不依賴任何 schoolId 參數就能讀到。規則本身只驗證「本人讀寫自己那一份」+
//      「schoolId 必須指向一所存在的學校（configExists）」，不驗證 email_verified——本階段
//      唯一的寫入路徑是 authGuardV2.resolveIdentity() 在既有 isMember/isInitialDirector 等
//      機制已經驗證過登入合法性「之後」才呼叫一次，不是任意登入者可自行決定寫入任意
//      schoolId 的開放端點；email_verified 留給 Stage 4（開放註冊，屆時任意登入者都可能
//      觸發建校/加入流程）收緊，見下方 match 區塊內的完整說明。
//   9. Stage 4（2026-07-31，RESEARCH-multitenancy-semester.md §4／RESEARCH-blaze-followup.md；
//      多租戶開通——自助申請 + 平台管理者輕量審核，非全自助建校）：新增三個頂層集合：
//        - schoolApplications/{uid}（doc id 綁申請人 uid，一人一份，同 joinAttempts 的
//          「doc id 天然限流」設計）：申請開通新學校。create 需 isEmailVerified()；
//          platformAdmin 可 update 狀態（pending→approved/rejected）；申請人本人只能在
//          status=='rejected' 時重新 update 回 'pending'（重新申請）；pending 期間任何一方
//          都無法再用 create/update 產生第二份或搶改狀態（doc id 唯一 + 狀態機約束）。
//        - platformAdmins/{uid}：平台管理者名冊，client 完全唯讀（write: false），只能由
//          開發者以 gcloud/REST 離線寫入（scripts/bootstrap-platform-admin.js，只寫不執行）。
//          isPlatformAdmin() 是本階段唯一新增的信任錨點，見該 helper 定義處的權限面說明。
//        - schoolDirectory/{schoolId}：公開學校名錄（僅 schoolName/createdAt），供申請頁
//          檢查 schoolId 是否已被使用；任何登入者可讀，寫入僅 platformAdmin、僅 create。
//      既有 schools/{schoolId}/config/{docId} 的 write 規則新增一條 platformAdmin **create**
//      分支（不含 update/delete；v2.17 起 platformAdmin 視同每校主任，另可經 isDirector 寫入，見第 18 點）——新校核准當下還沒有 director，只有 platformAdmin 能完成
//      config/main 的首次建立；核准動作分兩步循序執行（v2.17 起第一步為 transaction、第二步為 writeBatch，非單一原子操作），
//      理由、schoolId 衝突處理與失敗重試設計見
//      src/js/modules/v2/schoolApplicationService.js 的 approveApplication() 檔頭註解——
//      簡述（v2.17 已改）：Stage 4 原本靠「platformAdmin 對 config/main 只有 create 權限」當 schoolId 衝突防線；
//      v2.17 起 platformAdmin 視同每校主任（見第 18 點），rules 不再擋覆寫既有學校，改由 approveApplication()
//      在 transaction 內先讀 config/main、已存在就中止、不存在才寫入。
//      userDirectory 的自寫分支新增 isEmailVerified() 檢查（Stage 3 上線時刻意留白，見上方
//      該處說明，本階段開放註冊後補上；相容性見該 match 區塊內的完整註解）；新增
//      platformAdmin 分支（approval 時代寫申請人的 userDirectory，不要求 email_verified——
//      申請人的 email 已在 schoolApplications 的 create 規則驗證過一次，不重複驗證同一件事）。
//      權限面（Stage 4 原設計 → v2.17 已改）：Stage 4 原本刻意讓 platformAdmin **不能**讀取任何學校的
//      config/teachers/substituteRecords 等業務資料、只開 config create；v2.17 起使用者決定改為「全系統最高管理員」，
//      platformAdmin 在每所學校都能行使主任權限（讀寫該校全部資料），見下方第 18 點。
//      platformAdmin 也**能**代寫任意 uid 的 userDirectory（不限申請中那一位），這是刻意
//      接受的權限面（理由見 userDirectory match 區塊內的完整說明），與 director 可代寫校內
//      任何 userMappings 屬同一信任模型，非本次新增的獨立破口。
//
//      App Check（classic reCAPTCHA v3，非 Enterprise，理由見 RESEARCH-blaze-followup.md §3）
//      與支出風控（多門檻預算警報 + scripts/emergency-brake.js 緊急煞車腳本）皆為
//      client SDK／Console／離線腳本層面的措施，與本檔規則內容無直接關聯，不在此列。
//
//  10. v2.9（2026-10-22）角色異動護欄：teachers 的 update，director 分支新增「不可改自己教師檔的
//      role」——避免唯一的主任誤把自己降級而鎖死。「自己」＝ myTeacherId(schoolId) == teacherId
//      （userMappings.linkedTeacherId，沿用既有判定，不另創）。規則無法計數「還剩幾位主任」，
//      故只擋「改自己」，改別人、改自己的其他欄位不受影響。initialAdminEmails 白名單分支
//      （bootstrap 補登）刻意不動，作為緊急後備：白名單主任仍可改自己 role 救援。
//
//  11. v2.10（2026-11-05，docs/PLAN_2026-11-05_schedule-import-history.md；課表匯入日期與版本紀錄）：
//      schedules/{semesterId} 底下新增子集合 imports/{importId}，每次匯入／還原課表存一筆
//      （中繼資料 + 快照），供教學組自行「還原成這一版」。read 為 isMember；create 為 approver 且僅
//      限目前學期（與主文件同鎖）；update 一律禁止（版本紀錄不可改寫，要更正就再新增一版）；
//      delete 僅 director 且僅限非目前學期（供 Stage 5 封存清理，與主文件的 delete 規則同構）。
//      主文件 schedules/{semesterId} 的規則不變，新增的 lastImport 欄位屬主文件內容，不需改規則。
//      ⚠ 部署順序：須先部署本規則再上線新版 client，否則新 client 寫 imports 會被拒（主文件仍可寫，
//      只是匯入紀錄寫入失敗）。
//
//  12. v2.11（2026-11-07，使用者決定「開放組長刪除」）：substituteRecords 的 delete 由「僅 director」
//      放寬為「director，或 approver 且紀錄屬目前學期（無 semesterId 的舊紀錄視為可刪）」。
//      前端 adminDeleteRecord 與紀錄頁刪除鈕本就以 approver 判定，過去組長按下會被 rules 擋成
//      「權限不足」。private/detail 的 delete 維持僅 director（adminDeleteRecord 只刪父文件，
//      與既有行為相同）。刪除由前端寫 DELETE 操作日誌（含刪除前內容）。
//
//  13. v2.12（2026-11-10，資安審計「身分與授權」面修補；測試見 test/emulator/rules-identity／
//      rules-consent／rules-field-whitelist／rules-workflows／rules-v1-backup）：
//      H1 以 token.email 作為身分依據的地方一律要求 email_verified（isEmailVerified()）：白名單主任、
//         成員資格、userMappings 自建、emailIndex 讀取。
//      H2 成員資格要求「mapping 指向的教師檔存在 + 教師檔 email 等於登入者 email」，教師被刪除／email 被改
//         後原帳號立即失效；deleteTeacher／updateTeacher 一併刪除 mapping（前端）。
//      M1 同意人只能變動自己那一筆（isValidConsenterUpdate）；approver 不得觸碰同意名單。
//      M2/L4 private/detail docId 鎖 'detail'，非 approver 只能為自己的紀錄／申請建立。
//      M3 稽核日誌 actor 必須是登入者本人、timestamp 不得為未來、欄位／長度上限。
//      M4 users/{uid}/** 收斂為 users/{uid}/data/substituteSystem（V1 個人備份）＋欄位與大小約束。
//      M5/M6 pendingRequests／自我調課紀錄欄位白名單、保留欄位 reqId／recordId 禁用、長度與未來時間限制。
//      L2 joinAttempts.email 須為本人；L3 發起人不可刪已核准申請；L5 舊 data/{docId} 禁寫；
//      L6 approver 更新紀錄不得改稽核欄位。
//      v2.12b（驗收補強，test/emulator/rules-hardening）：id 清單元素檢查（idList20／idList30）、日誌 details
//      改單一限長 JSON 字串、approver 欄位只在對應狀態轉換可寫、actor.role 比對教師檔、substituteRecords
//      approver 更新改白名單、id／batchId 格式、時間絕對下界 2026-03-01、教師自改 authProvider 限值。
//      評估成本：規則引擎每次請求最多評估 1000 個運算式、函式不 memoize，熱路徑（isMember／isApprover）
//      與驗證 helper 都刻意精簡；新增規則前務必跑 rules-workflows（涵蓋最壞路徑）。
//
//  14. v2.13（2026-11-11，資料遺失類修補；測試見 test/emulator/rules-backup-restore）：
//      A. isCurrentSemesterAfter()（getAfter）：schedules create 改以「提交後」的 config.currentSemester 判斷，
//         讓「開新學期」在同一個 transaction 內改 config 並建立空白課表（原子）；config 的寫入權限仍只有
//         director，沒有改 config 的一般寫入 getAfter 等於 get，approver 無法藉此繞過學期鎖。
//      B. schedules 課表 version：create 必須 version==1；update 必須 version==現值+1（舊文件無 version 視為 0）。
//         前端 saveSchedule() 在 transaction 內讀現值、比對讀取時版本才寫入；本規則確保舊版頁面／console
//         「不帶版本或以過期版本整份覆寫」一律被拒，兩位 approver 不會互相蓋掉（審計 logic-flow M-4）。
//      ⚠ 部署順序：須先上線新前端（會寫 version）再部署本規則；舊版頁面在新規則下寫課表會 permission-denied，需重新整理。
//         scripts/ 以 owner 憑證操作的腳本不受 rules 限制。
//
//  15. v2.14（2026-11-14，P6 衝堂與申請流程；測試見 test/emulator/rules-records-lock）：
//      config/recordsLock：「成立紀錄」的序號鎖，只有 approver 可建立／更新，欄位只有 seq（整數）與 updatedAt，
//      create 必須 seq==1、update 必須剛好 seq==現值+1。前端核准、組長代發與組長批次在同一個 transaction 內
//      把 seq 加 1（recordsGuard.js），兩筆併發的成立動作必有一筆因序號已被改而重新驗證衝堂，只成立一筆。
//      運算式成本：本條只在 config 寫入時評估（isApprover 與 substituteRecords 寫入共用同一批文件讀取），
//      未動到熱路徑；substituteRecords／pendingRequests 的規則一字未改。
//      序號鎖涵蓋範圍與例外（據實記載）：
//        - 涵蓋：核准（approveRequest）、組長代發（adminCreate）、組長批次這三條「成立紀錄」路徑，由前端在同一個
//          transaction 內把 seq 加 1；rules 只保證 seq 的值只能剛好加 1、只有 approver 能寫。
//        - 不遞增 seq 的成立路徑：教師自我調課（rules 的 isSelfSwap 快速路徑直接成立，教師也不能寫 recordsLock）、
//          備份還原、舊資料遷移、adminEditRecord（目前 UI 未使用）。這些路徑不受序號鎖保護，也沒有伺服器端衝堂重驗。
//        - rules 並不強制「新增 substituteRecords 必須同交易遞增 seq」，這是前端協定；director 依 config 既有規則
//          可寫或刪 recordsLock。因此序號鎖是防止正常操作下的併發雙重成立，不是防止刻意繞過前端的授權機制。
//        - 自我調課改走伺服器端重驗、或由 rules 強制序號，留待後續階段。
//      ⚠ 部署順序（修正）：舊 rules 的 config/{docId} 只允許 director 寫入，新前端在舊 rules 下，教學組長（section_chief）
//        的核准與代發會因寫 recordsLock 全部 permission-denied；而 v2.13 又要求前端先上線。兩者合起來的結論是：
//        前端與 rules（v2.13＋v2.14）必須同時上線，不可任何一方單獨先上。步驟見 docs/DEPLOYMENT.md。
//
//  16. v2.15（P7 月結算正確性；測試見 test/emulator/rules-p7-config）：
//      A. config/settlement 增加可選欄位 weeklyBaseByTeacher（逐人超鐘點門檻，map，最多 400 筆）。存取權限不變：只有 approver 可讀可寫。
//      B. 新增 config/grade9（九年級畢業設定）：{ semesterId, enabled, effectiveDate, updatedAt, updatedBy }。
//         所有成員可讀（推薦與衝突判斷要用），只有 approver 可寫；欄位白名單與長度上限。設定只對 semesterId 所指的學期有效，
//         換學期後前端視為未啟用（不需要改規則）。
//      運算式成本：兩條都只在 config 寫入時評估，沿用既有 isApprover()，未動到熱路徑；規則引擎單次請求上限 1000 個運算式，
//      本次新增的欄位檢查合計約 14 個。
//      ⚠ 部署順序：新前端寫 weeklyBaseByTeacher／config/grade9 需要本規則；舊規則下這兩項儲存會被拒（其餘功能不受影響）。
//        與 v2.13＋v2.14 一起同時上線即可，沒有新增順序約束。
//
//  17. v2.16（P9 批次 A；測試見 test/emulator/rules-teacher-fields）：
//      A. teachers delete：director 不可刪除自己的教師檔（myTeacherId != teacherId），避免把自己鎖在系統外。
//         bootstrap 白名單主任沒有 mapping 時 myTeacherId 為 ''，不受影響；刪別人照舊。
//      B. teachers update 的 approver（組長）分支加欄位白名單：affectedKeys 只能是 domains／homeroomClass／partTime／updatedAt
//         （教師管理頁組長實際會寫的欄位），並限制型別與長度（isValidChiefTeacherPatch）。name／email／role／createdAt 及任何
//         多餘欄位組長一律不可改，因此組長改不了主任（或任何人）的姓名與角色。director 分支與自己改 authProvider 的分支不變，
//         主任權限不縮減。⚠ 日後教師檔新增由組長可編輯的欄位，必須同步加進白名單，否則教師管理頁該欄位儲存會被拒。
//      C. substituteRecords／pendingRequests 的 private/detail delete 放寬：除 director 外，approver 可刪（紀錄側限目前學期，與父文件
//         delete 同鎖；父文件已不存在視為孤兒清理，放行）；pendingRequests 側另允許發起人本人
//         （只限未結案或已駁回的申請；被邀請人不開放）。前端撤回、關閉駁回通知、刪紀錄時以交易／batch 同時刪 private/detail 與父文件，避免留下假別事由孤兒。
//      D. pendingRequests 父文件新增可選欄位 hasDetail（bool）：前端建立有私有明細的申請時標記，核准時若標記為真卻讀不到明細就中止。
//      運算式成本：teachers update 組長分支新增約 60 個運算式（含 idList20），只在組長改教師檔時評估；delete 規則多 1 次
//      myTeacherId（已被 isDirector 讀過同批文件，不增加文件存取數）。substituteRecords／pendingRequests 熱路徑未動。
//      ⚠ 部署順序：v2.16 增量本身沒有順序要求；整體仍照 v2.13＋v2.14 的同時上線步驟（先推前端、緊接著發布 rules，見 docs/DEPLOYMENT.md）。
//        新 rules 對舊前端無相容問題；新前端在舊 rules 下：刪 private 被拒時前端退回只刪父文件並記錄 detail_delete_failed，不阻擋撤回／刪除，
//        但送出有明細的申請會因 hasDetail 欄位不在舊 rules 白名單而被拒——這正是前端與 rules 須同時上線的理由之一（空窗以分鐘計）。
//
//  18. v2.17（2026-11-17，P9 批次 A2，使用者三項權限決定；測試見 test/emulator/rules-p9-authz）：
//      A. 初始主任白名單自動失效（SB-L9）：config/main.directorEstablished（布林旗標）為 true 時，isInitialDirector 恆為 false，
//         一次關掉所有白名單分支（isDirector／isApprover 的白名單後備、teachers 的 bootstrap 建檔與補登自己 role、config 讀取後備、
//         actorRoleOk）。旗標由前端 authGuardV2 在「正式主任」（教師檔 role 為 director/admin、已有 mapping）登入時補設，
//         既有正式庫另有 scripts/set-director-established.js（dry-run 預設）。旗標只進不退：config/{docId} 規則禁止
//         client 改回 false／非布林／拿掉欄位，也禁止刪除已確立的 config/main（刪掉重建會重開白名單）。
//         旗標缺席＝尚未確立，行為與 v2.16 相同。後備：platformAdmin（見 B）不受白名單與旗標影響，學校不會因白名單失效而無人可管。
//      B. platformAdmin 為全系統最高管理員：isDirector／isApprover 加 isPlatformAdmin() 分支；所有 `allow read: if isMember`
//         改用 canReadSchool（成員或 platformAdmin）；config 讀取後備（isMemberOrBootstrapDirector）加 platformAdmin。這取代檔頭
//         第 9 點「platformAdmin 不能讀任何學校 config」的舊設計。platformAdmins/{uid} 維持 client 完全不可寫（`allow write: if false`
//         同時涵蓋 create／update／delete）：任何 client——包含 platformAdmin 本人、主任、組長——都不能新增、修改或撤銷任何
//         platformAdmin；新增只能由開發者以 scripts/bootstrap-platform-admin.js（Admin 憑證）執行，因此不保留「platformAdmin
//         建立 platformAdmin」的路徑（本來就沒有）。platformAdmin 的身分判斷只看 platformAdmins/{uid}，與任何學校的名冊、角色、
//         白名單、旗標、刪除操作無關。platformAdmin 沒有教師檔，前端以 uid 當 teacherId：approvedBy／rejectedBy／日誌 actor.teacherId
//         都接受 uid（isActorId、isValidOperationLog 的 platformAdmin 分支）。
//      C. 職務分離（SB-I7）：isValidApproverUpdate 的核准分支要求申請的 initiatedBy 不是核准者自己（uid 或 mapping teacherId），
//         唯一例外 isSelfOnlyRequest（isSelfSwap、換走與換進教師都是本人、無其他同意人）。對 platformAdmin 同樣適用。
//         （v2.18 起 pendingRequests create 已無 approver 分支，approver 不能建立申請，也就不能偽造 initiatedBy 來繞過本規則，見第 19.A2 點。）駁回不受限。
//         ⚠ 已知範圍：組長／主任的「代發」（adminCreate）是直接成立 substituteRecords，不經 pendingRequests、不經核准，因此本規則
//         管不到（approver 本來就能直接建立任意紀錄，initiatedBy 由 client 填）；真正的職務分離只涵蓋 pendingRequests 的核准轉換。
//      ⚠ 如實揭露（使用者已接受，不在 rules 堵）：職務分離只是「防止誠實操作下的誤用」，不是安全邊界——
//        (1) 組長／主任本來就能以「代發」（adminCreate）直接成立紀錄、不經核准；
//        (2) approver 以 approver 分支建立申請時，initiatedBy 可填成別人或任意字串，再自己核准；
//        (3) isSelfOnlyRequest 只比對 id（type 為「代課」、姓名寫別人也能被判成自我調課）。
//        這三條都不比「代發」多拿到任何能力。另：舊申請缺 initiatedBy 時，沒有成員身分的 platformAdmin 會被判成「自己發起」而擋下核准。
//      運算式與文件存取：isPlatformAdmin 放在各分支最後，一般教師多 1 次 platformAdmins exists（不同路徑，+1 次文件存取）；
//      最壞路徑實測見 test/emulator/rules-p9-authz.mjs 與 docs/DEPLOYMENT.md v2.17 段。
//      ⚠ 部署順序：與 v2.13–v2.16 同一套程序，前端與 rules 同時上線（先推前端、緊接著發布 rules）。新 rules 對舊前端：白名單未失效前
//        行為不變（旗標缺席）、platformAdmin 舊前端不會用到、核准按鈕舊前端仍會顯示於自己的申請但被 rules 擋下（permission-denied）。
//        新前端在舊 rules 下：寫 directorEstablished 旗標在 v2.16 rules 下是允許的（config 任意欄位 director 可寫）但無作用；
//        platformAdmin 進入學校會因舊 rules 拒讀而失敗（不影響一般使用者）。
//
//  19. v2.18（2026-11-17，LC-L7／LF-M8，使用者決定：紀錄與申請的學期歸屬依「該筆的 date」推算，不再取建立當下的目前學期；
//      測試見 test/emulator/rules-semester-by-date；前端推算規則見 src/js/modules/v2/semesterUtils.js semesterIdForDate）：
//      A. substituteRecords／pendingRequests 的 create：semesterId 除了「等於目前學期」（原行為，不變），另允許「與目前學期
//         相鄰（前一個或後一個學期）、且 semesterId 與該筆 date 依台灣學制（8/1–翌年 1/31 上學期、2/1–7/31 下學期）推算的
//         結果完全一致」的寫入（semesterOfDate／canWriteSemester）。date 必須是 YYYY-MM-DD 且月日
//         合法；前一個學期另要求 archives/{semesterId} 不存在（已封存學期不可再補寫），下一個學期不可能已封存故省略該次
//         exists()。兩個以上學期遠的日期、semesterId 與 date 對不上的寫入一律拒絕。isDeclaredLegacyWrite 豁免不變。
//      A2. （A2-2 驗收補修）兩個集合的「等於目前學期」分支也要求 date 合法且推算學期等於 semesterId（目前學期為標準格式時）；
//         update 改 date 時新日期推算的學期須仍等於 semesterId。
//         ⚠ pendingRequests create 移除 approver 分支：只剩 isTeacherPendingCreate（發起人必須是本人）。原因：approver 分支在
//         運算式預算上已無餘量（組長代發調課申請目前學期剩 0、相鄰學期超過 1000 被拒），而前端沒有任何路徑會走到它
//         （組長與主任＝roleSvc.isAdmin() 寫入一律走 adminCreate 直接成立紀錄；非 approver 才呼叫 createRequest；platformAdmin 以
//         director 身分同樣走 adminCreate）。同時封住 A2-1 揭露的「approver 建申請可偽造 initiatedBy 以繞過職務分離」。
//         第 18.C 點所述「組長代教師發起申請」的 pendingRequests 路徑因此不再存在（approver 要代發只能走 adminCreate）。
//      B. substituteRecords 的 update／delete（approver 分支）與四個 private/detail 父文件學期函式：原「須屬目前學期」放寬為
//         「目前學期或其下一個學期」（isCurrentOrFutureSemester，上限目前學期＋1）。理由：預先登記的下學期紀錄尚未結算，組長要能更正／刪除登記
//         錯誤的預登紀錄；已過去學期（含換學期後補登的上學期紀錄）仍唯讀，組長不可改刪，director 刪除不受限（不變）。
//      C. 不變：archives 的 create-only／不可改刪；schedules／imports 的目前學期鎖與 delete 限非目前學期；
//         semesterId 建立後不可變。update 規則沒有新增「改 date 須同步 semesterId」的檢查（adminEditRecord 無 UI 呼叫點，
//         且月結算依 date 取資料，不受 semesterId 影響），列為已知殘留。
//      運算式／存取成本：A 對「semesterId＝目前學期」的原路徑只多 1 次短路求值（不增加文件存取）；相鄰學期路徑只讀已被
//         讀過的 config/main，前一個學期另加 1 次 archives exists()。
//      ⚠ 部署順序：與 v2.13–v2.17 同一套程序，前端與 rules 同時上線。新前端在舊 rules 下：依日期歸屬到相鄰學期的寫入會被拒
//        （permission-denied，目前學期內的日期不受影響）；舊前端在新 rules 下：行為不變（舊前端仍寫目前學期）。
//
// 部署：透過 gcloud REST API 或 Firebase Console（見 docs/V2_PERMISSION_SYSTEM.md）

service cloud.firestore {
  match /databases/{database}/documents {

    // ================ 共用 helpers ================

    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    // v2.12（身分與授權修補）：「以 token.email 作為身分依據」的地方一律先過這個輔助函式。
    // Firebase Email/Password 註冊不驗證信箱所有權，任何人都能用別人的 email 註冊出一個
    // token.email 等於該 email、但 email_verified == false 的帳號（搶註）。Google 登入的
    // email_verified 恆為 true，不受影響。用到的地方：isInitialDirector（白名單主任）、
    // isMember（成員資格，間接涵蓋 mapping 自建後的所有讀寫）、userMappings 自建、
    // emailIndex 讀取、userDirectory／joinAttempts／schoolApplications（Stage 4 起已有）。
    // 注意：Auth 帳號的 emailVerified 變更後，ID token 內的 claim 要等 token 刷新才更新；
    // 前端（v2-app.js 的驗證遮罩）在使用者按「我已完成驗證」時會 reload() + getIdToken(true)。
    function isEmailVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function configExists(schoolId) {
      return exists(/databases/$(database)/documents/schools/$(schoolId)/config/main);
    }

    function configDoc(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/config/main).data;
    }

    // 登入 email 是否在初始主任白名單（欄位名稱沿用 initialAdminEmails 兼容舊 config）
    // 驗收修復 S5-R：token email 用 .lower() 正規化後再比對。Firestore 規則語言沒有
    // 「對陣列逐項套用 .lower() 再比對」的內建操作（hasAny 只能比對既有值，無法先轉換
    // 陣列內容），所以無法讓這一行同時容忍陣列內容大小寫不一致——約束記錄在這裡：
    // ⚠️ initialAdminEmails 陣列內容本身必須全部是小寫，否則大寫寫入的白名單 email
    // 會比對不到而永遠無法用該白名單身份登入。scripts/firestore-bootstrap-inhu.js 寫入
    // 前一律 .toLowerCase()（見該檔 ensureConfig()），docs/STAGE0-DEPLOY.md 的前置確認
    // 也列了這一項檢查，任何手動編輯 initialAdminEmails 的操作都必須遵守這個約束。
    // v2.12：必須 email_verified（見 isEmailVerified 說明）——否則任何人只要用白名單 email
    // 註冊一個未驗證的 Auth 帳號，就直接取得主任權限。
    // v2.17（SB-L9）：學校一旦有正式主任，config/main.directorEstablished 會被設為 true，白名單分支即永久失效
    // （一次關掉所有白名單特例：bootstrap 建教師檔、補登自己 role、isDirector／isApprover／config 讀取的白名單後備、
    // actorRoleOk 的白名單 director）。旗標只能由 client 設 true、不可改回或刪除（見 config/{docId} 規則），
    // 最後的後備是 platformAdmin（isPlatformAdmin，見 isDirector）。旗標缺席 = 尚未確立，沿用舊行為。
    function isInitialDirector(schoolId) {
      return isEmailVerified()
        && configExists(schoolId)
        && configDoc(schoolId).get('directorEstablished', false) != true
        && listHasItem(configDoc(schoolId).initialAdminEmails, userEmail().lower());
    }

    // 成本精簡：initialAdminEmails 只讀一次（原本 is list 與 hasAny 各呼叫一次 configDoc）。
    function listHasItem(l, item) {
      return l is list && l.hasAny([item]);
    }

    function mappingExists(schoolId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/schools/$(schoolId)/userMappings/$(request.auth.uid));
    }

    // ---- Stage 4（2026-07-31）：平台管理者（跨校信任錨點）----
    // （isEmailVerified() 於 v2.12 搬到檔案最前面的共用 helpers，見 userEmail() 下方）

    // platformAdmins/{uid} 完全禁止 client 寫入（見下方頂層 match 區塊），只能由開發者以
    // gcloud/REST 離線建立，是本次新增功能中唯一的信任根——理由與範圍見該 match 區塊註解。
    // v2.17：權限面擴充——platformAdmin 在每一所學校都等同主任（isDirector／isApprover 的最後一個分支，
    // 讀取走 canReadSchool），不需要是該校成員，也不受該校任何名冊、角色、白名單、刪除操作影響
    // （本函式只看 platformAdmins/{uid}，與任何 schoolId 無關；那份文件 client 不可寫、不可刪）。
    // 職務分離（isValidApproverUpdate）對 platformAdmin 同樣適用。
    // 沒有 schoolId 參數：platformAdmin 身份與「哪一所學校」無關，是跨校的平台層概念，
    // 因此定義在 schools/{schoolId} 的 match 樹之外也適用（helpers 區在 match 樹外共用）。
    function isPlatformAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    // 新校首次建立 config/main 的欄位驗證（Stage 4 核准流程唯一使用點，見
    // schools/{schoolId}/config/{docId} 的 create 規則）。
    // opus 驗收 L2：initialAdminEmails 原本只驗證「是 list 且非空」，未逐項驗證元素型別。
    // Firestore 規則語言（CEL 子集）沒有確認可用的通用「對每個元素套用述語」語法
    // （`.all()`/`.map()` 這類 CEL 巨集在 Firestore Security Rules 官方文件未見明確列為
    // 支援項目，本檔其餘 900+ 行也從未使用過，貿然採用有部署期才會發現語法錯誤的風險，
    // 不採用）。改用「精確比對實際寫入形狀」的方式收緊：approveApplication() 的唯一寫入
    // 呼叫點永遠只寫 `initialAdminEmails: [applicantEmail]`（單一元素），故直接鎖
    // `size()==1` 並用陣列索引 `[0] is string` 驗證該唯一元素型別——這比「逐項驗證」更嚴格
    // （不僅驗證型別，連元素數量都鎖死符合唯一合法呼叫端的實際形狀），且只用了本檔已大量
    // 使用、確認可用的語法（`size()`、陣列索引、`is string`）。如實記錄：這不是「做不到逐項
    // 驗證所以退而求其次」，而是「單一元素的形狀下，逐項驗證與索引驗證等價，且後者語法
    // 風險更低」。
    function isValidNewSchoolConfigWrite(data) {
      return data.keys().hasOnly(['schoolName', 'currentSemester', 'initialAdminEmails', 'createdAt', 'updatedAt'])
        && data.schoolName is string && data.schoolName.size() > 0 && data.schoolName.size() < 100
        && data.currentSemester is string
        && data.initialAdminEmails is list && data.initialAdminEmails.size() == 1
        && data.initialAdminEmails[0] is string
        && data.createdAt is string && data.updatedAt is string;
    }

    // opus 驗收 L3：schoolApplications 的 platformAdmin 審核欄位（reviewedAt/reviewedBy/
    // rejectReason）原本只有 hasOnly() 白名單，沒有型別/長度驗證。三個欄位皆為選填（同一次
    // update 不一定會全部帶到，例如核准動作不帶 rejectReason），且 JS 端在缺值時可能寫入
    // `null`（見 schoolApplicationService.js 的 `reviewer || null`／`... || null`），故驗證
    // 邏輯需同時容忍「欄位不存在」與「欄位為 null」兩種情況，比照 archives 的 `note` 欄位
    // （firestore.rules 既有的 `!('note' in ...) || (...)` 模式）與 substituteRecords 的
    // `details is map || details == null` 模式撰寫。
    function isValidSchoolApplicationReviewFields(data) {
      return (!('reviewedAt' in data) || data.reviewedAt is string)
        && (!('reviewedBy' in data) || data.reviewedBy == null || data.reviewedBy is map)
        && (!('rejectReason' in data) || data.rejectReason == null
             || (data.rejectReason is string && data.rejectReason.size() < 500));
    }

    function myMapping(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/userMappings/$(request.auth.uid)).data;
    }

    // ---- Stage 0（2026-07-31）：成員資格隔離 ----
    // 「該 uid 在該校有一份合法的 userMappings 文件」＝ 該校成員。userMappings 的自建規則
    // （見下方 match /userMappings/{uid}）已保證 linkedTeacherId 只能指向 email == 本人登入
    // email 的教師檔，故此檢查不可偽造，是校際隔離讀取規則的唯一依據。
    //
    // v2.12（H2 修補：mapping 永不撤銷）：mapping 存在不再等於成員。每次請求都重新驗證三件事：
    //   (1) token 的 email 已驗證（isEmailVerified）；
    //   (2) mapping.linkedTeacherId 指向的教師檔仍然存在（教師被刪除 → 立即失去成員資格）；
    //   (3) 該教師檔的 email 仍等於登入者 email（email 被改掉／改派 → 舊帳號立即失效，
    //       新 email 的帳號下次登入走 emailIndex 重新建立 mapping 即可）。
    // 比對一律用 userEmail().lower()：teachers.email 一律小寫儲存（createTeacher 正規化），
    // 與 userMappings 自建規則、isInitialDirector 同一慣例。
    // get()/exists() 成本：mapping 與教師檔都是本請求其他規則本來就會讀的文件
    // （myTeacherId/myTeacherDoc），同一路徑的重複存取不增加不同文件數，不會多出新的上限壓力
    // （emulator 實測見 test/emulator/rules-identity.mjs 的最壞路徑案例）。
    // 規則引擎有「每次請求最多評估 1000 個運算式」的上限，函式呼叫不會 memoize，
    // 所以 tid 用參數傳入（只算一次），isMember 本身也盡量避免在同一條規則裡被重複呼叫
    // （需要 teacherId 的規則請用 let me = myTeacherId(schoolId) 一次取好）。
    function teacherEmailMatches(schoolId, tid) {
      return tid is string
        && exists(/databases/$(database)/documents/schools/$(schoolId)/teachers/$(tid))
        && get(/databases/$(database)/documents/schools/$(schoolId)/teachers/$(tid)).data.email == userEmail().lower();
    }

    function isMember(schoolId) {
      return isEmailVerified()
        && mappingExists(schoolId)
        && teacherEmailMatches(schoolId, myMapping(schoolId).linkedTeacherId);
    }

    // 首登尚未綁定 mapping 者的例外：白名單初始主任。isInitialDirector 內部用 get() 讀
    // config，屬規則內部呼叫、不受 read 規則限制，因此收緊 config 的 read 不會讓白名單失效。
    function isMemberOrBootstrapDirector(schoolId) {
      return isMember(schoolId) || isInitialDirector(schoolId) || isPlatformAdmin();
    }

    // v2.17：「可讀取該校資料」＝成員，或 platformAdmin（跨校最高管理員不需成員資格）。
    // 所有原本 `allow read: if isMember(schoolId)` 的地方改用這個；寫入不改，仍各自靠 isApprover／isDirector。
    function canReadSchool(schoolId) {
      return isMember(schoolId) || isPlatformAdmin();
    }

    // v2.12：myTeacherId 只在「有效成員」時回傳 teacherId，否則回傳 ''（既有規則用
    // `myTeacherId(schoolId) != ''` 當「我是成員」判斷的地方因此自動套用教師檔存在 + email
    // 相符 + email 已驗證三項檢查，不必逐條改寫；已刪除教師的原帳號自建紀錄／申請會被擋下）。
    function myTeacherId(schoolId) {
      return isMember(schoolId) ? myMapping(schoolId).linkedTeacherId : '';
    }

    function myTeacherExists(schoolId) {
      return isMember(schoolId);
    }

    // 只在 isMember(schoolId) 已成立之後呼叫（直接用 mapping 的 linkedTeacherId，不再經 myTeacherId，
    // 避免重複評估 isMember）。
    function myTeacherDoc(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/teachers/$(myMapping(schoolId).linkedTeacherId)).data;
    }

    // ---- Stage 2（2026-07-31，RESEARCH-multitenancy-semester.md §6.1）：學期唯讀鎖 ----
    // 「該學期是否為目前作用中的學期」。configDoc() 讀的是 config/main，這份文件在
    // isDirector()/isApprover() 判斷鏈中已經因 isInitialDirector() 被讀過一次——同一請求內
    // 對同一份相依文件重複 get() 只計費一次讀（§3.6 引 [C12]），故這條規則的「計費」成本是
    // 0；「存取呼叫數」則 +1（§3.6 的預算表已核實這條路徑最壞情況約 6~8 次，遠低於 10 次
    // 硬上限，加 1 次仍安全，不得再加在已逼近上限的 userMappings 自建路徑上）。
    // ⚠ 只可用於 create/update 規則（讀 configDoc 需要 schoolId 已在權限鏈某處被讀過，
    // 且只在寫入端有意義——讀取不受學期限制，歷史學期資料仍可被全校成員唯讀查詢）。
    function isCurrentSemester(schoolId, sid) {
      return configDoc(schoolId).currentSemester == sid;
    }

    // v2.13-A（已納入本檔）：「這次提交（batch／transaction）完成後」config 的目前學期是否為 sid。
    // 用途：「開新學期」要在同一個 transaction 內同時 (1) 把 config.currentSemester 改成新學期、
    // (2) 建立新學期的空白課表文件。schedules create 規則若只看 isCurrentSemester（提交前狀態），
    // 這兩件事無法原子完成（Stage 2 驗收「輕13」遇到的順序問題），舊流程只好分兩步，
    // 中途失敗會留下「currentSemester 指向不存在的課表」。
    // 安全性：config 的寫入權限仍只有 director（見 config/{docId}）；沒有 config 變更的一般寫入，
    // getAfter 等於 get，行為與 isCurrentSemester 完全相同，approver 無法藉此繞過學期鎖。
    // 成本：多 1 次文件存取呼叫（getAfter），schedules create 路徑最壞約 7~9 次，低於 20 次上限。
    function isCurrentSemesterAfter(schoolId, sid) {
      return getAfter(/databases/$(database)/documents/schools/$(schoolId)/config/main).data.currentSemester == sid;
    }

    // ---- v2.18（LC-L7／LF-M8）：學期歸屬依 date 推算 ----
    // 標準學期代碼（'115-1'）。非標準值（測試資料、手動設定的特殊值）一律走舊行為（只認 semesterId == 目前學期）。
    function isStdSemester(s) {
      return s is string && s.matches('^[0-9]{2,3}-[12]$');
    }

    // cur 的下一學期代碼（cur 須先過 isStdSemester）。直接組字串，運算式比序數／清單比較省。
    function nextSemester(cur) {
      let p = cur.split('-');
      return p[1] == '1' ? p[0] + '-2' : string(int(p[0]) + 1) + '-1';
    }

    function isIsoDateString(ds) {
      return ds is string && ds.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    // 台灣學制：8～12 月＝民國(西元-1911)學年上學期、1 月＝民國(西元-1912)學年上學期、2～7 月＝(西元-1912)學年下學期。
    // 與 src/js/modules/v2/semesterUtils.js dateToSemesterId 同式。呼叫前須先過 isIsoDateString。
    function semesterOfDate(ds) {
      let p = ds.split('-');
      let late = p[1] >= '08';
      return string(int(p[0]) - (late ? 1911 : 1912)) + ((late || p[1] == '01') ? '-1' : '-2');
    }

    // create 用：semesterId 等於目前學期（原行為）或與目前學期相鄰（v2.18）。
    // 目前學期為標準格式時，兩條路徑都要求 date 是合法日期且依台灣學制推算的學期等於 semesterId——
    // 擋下「把已封存學期、已結算月份的日期、很久以前的日期、沒有 date 標成目前學期」的注入。
    // 目前學期不是標準格式時維持舊行為：只認 semesterId == 目前學期。
    // 相鄰判斷：sid 已等於 semesterOfDate(date)（必為標準格式），直接與「下一學期／上一學期」字串比對（cur 只 split 一次）；
    // 上一學期另要求 archives/{sid} 不存在（已封存不可再補寫），下一學期不可能已封存故省略 exists()。
    // substituteRecords 與 pendingRequests 的 create 共用（pendingRequests 的 approver 分支已移除，見檔頭第 19.A2 點）。
    function canWriteSemester(schoolId, d) {
      let cur = configDoc(schoolId).currentSemester;
      let sid = d.semesterId;
      let cp = cur.split('-');
      let ds = d.get('date', '');
      return cur.matches('^[0-9]{2,3}-[12]$')
        ? (ds.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$') && sid == semesterOfDate(ds)
            && (sid == cur
                || sid == (cp[1] == '1' ? cp[0] + '-2' : string(int(cp[0]) + 1) + '-1')
                || (sid == (cp[1] == '2' ? cp[0] + '-1' : string(int(cp[0]) - 1) + '-2')
                    && !exists(/databases/$(database)/documents/schools/$(schoolId)/archives/$(sid)))))
        : sid == cur;
    }

    // update／delete／private-detail 父文件用：目前學期，或目前學期的下一個學期（預登，尚未結算）；過去學期唯讀。
    function isCurrentOrFutureSemester(schoolId, sid) {
      let cur = configDoc(schoolId).currentSemester;
      return sid == cur || (isStdSemester(cur) && sid == nextSemester(cur));
    }

    // 教務主任：白名單 OR teacher.role in ['director', 'admin']（admin 為舊資料兼容）
    // v2.17：最後一個分支 isPlatformAdmin()＝全系統最高管理員，每所學校都視同主任。
    function isDirector(schoolId) {
      return isInitialDirector(schoolId)
        || (isMember(schoolId) && myTeacherDoc(schoolId).role in ['director', 'admin'])
        || isPlatformAdmin();
    }

    // legacyMigrationService.js 一次性遷移舊 V1 個人資料時，substituteRecords 的 date 可能
    // 落在任何過去學期（歷史真實日期），若強制學期鎖會讓整批遷移全部失敗。
    // ⚠ 驗收修復（阻斷 1）：原版只檢查請求自帶的 `isLegacy == true`——這個欄位完全由 client
    // 自行宣告、規則不驗證來源，任何能通過父層 create 條件的寫入者（isApprover 分支的
    // 任一 approver、甚至 isSelfSwap 分支的一般教師只要在 payload 塞 isLegacy:true）都能
    // 靠自我宣告繞過學期鎖、偽造任意歷史學期的紀錄。收緊為三個條件並用：
    //   1. isDirector(schoolId)——app 層 legacyMigrationService 的唯一觸發入口是
    //      roleService.canManageRoster()，其定義就是 isDirector()（見該檔），section_chief
    //      與一般教師本來就不可能觸發遷移，收緊不影響既有合法流程。
    //   2. migratedFrom 欄位存在——一般業務寫入（adminCreate／自我調課／approveRequest）都
    //      不會帶這個欄位，只有 legacyMigrationService 會寫（見該檔 migrateLegacyRecords）。
    //   3. semesterId 是字串——防止豁免路徑寫入型別不合法的值污染歷史查詢/封存分批。
    // isDirector() 內部的 get() 與其餘欄位讀取皆不觸發額外 get()/exists()（isDirector 在
    // 同一請求的權限鏈中已被讀過，計費成本為 0，理由同 isCurrentSemester()）。
    // 驗收修復（R3，opus 重驗）：本函式呼叫 isDirector()，改放在 isDirector 定義「之後」——
    // Firestore 規則語言的函式理論上允許前向參考（呼叫定義在後面的函式），但保守起見仍
    // 依宣告順序排列，避免任何規則引擎/工具鏈版本對前向參考的支援度落差帶來部署期意外。
    function isDeclaredLegacyWrite(schoolId, data) {
      return isDirector(schoolId)
        && ('isLegacy' in data) && data.isLegacy == true
        && ('migratedFrom' in data)
        && ('semesterId' in data) && data.semesterId is string;
    }

    // 具核准權（director + section_chief，舊 admin 兼容）
    function isApprover(schoolId) {
      return isInitialDirector(schoolId)
        || (isMember(schoolId) && myTeacherDoc(schoolId).role in ['director', 'section_chief', 'admin'])
        || isPlatformAdmin();
    }

    // 相容 alias：v2.1 期間程式碼語意中的「admin」現在等同「approver」。
    // 預留給跨檔案引用此 rules 的腳本，使其依語意持續可用。
    function isAdmin(schoolId) {
      return isApprover(schoolId);
    }

    // 新增 teachers doc 時的 role 欄位合法性
    function isValidRoleValue(role) {
      // 接受三層角色 + 舊 admin（authGuardV2 bootstrap 與資料遷移需要）
      return role in ['director', 'section_chief', 'teacher', 'admin'];
    }

    // v2.16（PL-T1）：組長（section_chief）可寫的教師檔欄位。來源：v2-app.js 教師管理頁的
    // 領域（domains）、導師班級（homeroomClass）、兼課（partTime）三個即存欄位，經 schoolDataService.updateTeacher 附帶 updatedAt。
    // 只比對「有變動」的欄位（affectedKeys），所以未動的既有欄位（name、createdAt…）不受影響；型別與長度只檢查被改動的欄位，
    // 避免舊資料某欄位本來就超長時組長改別的欄位被誤擋。updatedAt 必為近期 ISO 字串（isRecentIsoString）。
    function isValidChiefTeacherPatch(d, old) {
      let k = d.diff(old).affectedKeys();
      return k.hasOnly(['domains', 'homeroomClass', 'partTime', 'updatedAt'])
        && (!k.hasAny(['domains']) || (idList20(d.domains) && d.domains.join('').size() <= 400))
        && (!k.hasAny(['homeroomClass']) || (d.homeroomClass is string && d.homeroomClass.size() <= 30 && d.homeroomClass.matches('[^<>"]*')))
        && (!k.hasAny(['partTime']) || d.partTime is bool)
        && (!k.hasAny(['updatedAt']) || isRecentIsoString(d.updatedAt));
    }

    // ================ v2.12：欄位白名單／型別／長度／時間戳共用 helpers ================
    // 設計取捨（為什麼不改成 serverTimestamp）：前端所有時間欄位（createdAt、timestamp、approvedAt…）
    // 都是 new Date().toISOString() 字串，並被 orderBy('createdAt')／where('timestamp','>=',字串)
    // 這類查詢與 fmtDate() 顯示依賴；改成 Firestore Timestamp 會讓新舊資料混型（排序錯亂、既有
    // 查詢條件型別不符）。因此保留 ISO 字串，改由規則「以可驗證的方式約束」：固定格式 + 日期不得
    // 晚於伺服器時間（request.time）超過 1 天（容忍用戶端時鐘誤差；實際上限是約 2 天，因為只比對
    // 到「日」）。這封掉的是「把 createdAt／timestamp 設成 9999 年讓惡意資料永遠置頂
    // （orderBy desc limit 50）」這條路。
    // 評估成本：規則引擎每次請求最多評估 1000 個運算式，函式不會 memoize，所以下面的 helper
    // 刻意寫得短（isMember 約 95、isApprover 約 150、本函式約 45），熱路徑用 let 只取一次 me。
    // v2.12b（L-4）：加絕對下界 2026-03-01（系統上線於 2026-03，更早的時間不可能是合法的「現在」；
    // 用固定日期而非相對 request.time，是因為既有情境測試／離線排隊寫入帶的是較舊的真實時間，
    // 相對下界會隨時間流逝讓它們失效）。擋下「回溯成 2000 年偽造舊稽核紀錄」。
    function isRecentIsoString(s) {
      let day = timestamp.date(int(s.split('-')[0]), int(s.split('-')[1]), int(s.split('-')[2].split('T')[0]));
      return s is string
        && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$')
        && day >= timestamp.date(2026, 3, 1)
        && day <= request.time + duration.value(1, 'd');
    }

    // v2.12b（H-1b／H-1c）：id 清單（pendingConsentTeacherIds／allowedTeacherIds）的元素檢查。
    // 規則語言沒有 all()，這裡用「補空字串墊高長度 → 逐一 string() 串接」：string() 對 map／list
    // 會求值錯誤（元素型別檢查），串接後總長度 ≤ max×64 且不含 < > "，每個元素因此各自受限。
    // 不用逐元素條件式，是因為那樣每個元素要 8～9 個運算式；這個寫法約 3 個。
    function idList20(l) {
      let p = l.concat(['','','','','','','','','','','','','','','','','','','','']);
      let s = string(p[0]) + string(p[1]) + string(p[2]) + string(p[3]) + string(p[4]) + string(p[5]) + string(p[6]) + string(p[7]) + string(p[8]) + string(p[9]) + string(p[10]) + string(p[11]) + string(p[12]) + string(p[13]) + string(p[14]) + string(p[15]) + string(p[16]) + string(p[17]) + string(p[18]) + string(p[19]);
      return l is list && l.size() <= 20 && s.size() <= 1280 && s.matches('[^<>"]*');
    }

    function idList30(l) {
      let p = l.concat(['','','','','','','','','','','','','','','','','','','','','','','','','','','','','','']);
      let s = string(p[0]) + string(p[1]) + string(p[2]) + string(p[3]) + string(p[4]) + string(p[5]) + string(p[6]) + string(p[7]) + string(p[8]) + string(p[9]) + string(p[10]) + string(p[11]) + string(p[12]) + string(p[13]) + string(p[14]) + string(p[15]) + string(p[16]) + string(p[17]) + string(p[18]) + string(p[19]) + string(p[20]) + string(p[21]) + string(p[22]) + string(p[23]) + string(p[24]) + string(p[25]) + string(p[26]) + string(p[27]) + string(p[28]) + string(p[29]);
      return l is list && l.size() <= 30 && s.size() <= 1920 && s.matches('[^<>"]*');
    }

    // 案件（pendingRequests 與 substituteRecords 自我調課共用）的全部文字／id／數字類欄位，
    // 串接成一個字串後一次驗證——比逐欄呼叫 helper 省下大量運算式額度：
    //   - 任一欄位若不是字串（map／list…），與字串串接會直接求值錯誤而整條被拒（型別檢查）；
    //     可能為 null 或數字／布林的欄位用 string() 包起來（null → 'null'，數字／布林 → 文字）。
    //   - 總長度上限 1000 字元（各欄位長度因此都受限）；
    //   - 整串不得含 < > "（HTML 標籤／屬性注入所需字元）。這是 stored XSS source 端的縱深防禦，
    //     前端輸出跳脫由另一階段處理。正常資料（班級、科目、教師姓名、文號、日期、id）不含這三個字元。
    // 欄位清單從前端實際寫入的形狀歸納：app.js buildSwapRecord／confirmSubstitute／
    // confirmMultiCourseSubstitute 產出的 record + v2-app.js resolveApproverInfo 的 id 欄位。
    // leaveType／leaveTypeName／reason 已由 splitSensitive 搬到 private/detail，不在父文件。
    function hasSafeCaseText(d) {
      let all = string(d.get('type', '')) + '|' + string(d.get('date', '')) + '|' + string(d.get('swapDate', '')) + '|' + string(d.get('weekday', ''))
        + '|' + string(d.get('swapWeekday', '')) + '|' + string(d.get('period', '')) + '|' + string(d.get('swapPeriod', ''))
        + '|' + string(d.get('className', '')) + '|' + string(d.get('subject', '')) + '|' + string(d.get('swapSubject', ''))
        + '|' + string(d.get('domain', '')) + '|' + string(d.get('swapDomain', ''))
        + '|' + string(d.get('originalTeacher', '')) + '|' + string(d.get('substituteTeacher', '')) + '|' + string(d.get('swapTeacher', ''))
        + '|' + string(d.get('docNumber', '')) + '|' + string(d.get('initiatedByName', '')) + '|' + string(d.get('requiredApproverName', ''))
        + '|' + string(d.get('id', '')) + '|' + string(d.get('batchId', '')) + '|' + string(d.get('multiCourseGroupId', ''))
        + '|' + string(d.get('originalTeacherId', '')) + '|' + string(d.get('substituteTeacherId', ''))
        + '|' + string(d.get('swapTeacherId', '')) + '|' + string(d.get('requiredApproverId', ''))
        + '|' + string(d.get('batchSize', 0)) + '|' + string(d.get('multiCourseIndex', 0)) + '|' + string(d.get('multiCourseTotal', 0))
        + '|' + string(d.get('isMultiSwap', false)) + '|' + string(d.get('isMultiCourse', false));
      return all.size() <= 1000 && all.matches('[^<>"]*');
    }

    // v2.12b（L-1）：前端自產的 id／batchId／multiCourseGroupId 格式——app.js 一律是
    // Date.now().toString()（純數字），多節／批次再加 "_序號"。必須是字串（數字型別一律拒絕）。
    // batchId／multiCourseGroupId 嚴格要求純數字；id 放寬為英數／底線／連字號（情境測試 scenario-02
    // 的既有 payload 用 'zz_case_record'），仍然擋下引號、空白、& 與反引號等屬性注入字元。
    function hasValidCaseIds(d) {
      return (!('id' in d) || (d.id is string && d.id.matches('^[A-Za-z0-9_-]{1,40}$')))
        && (!('batchId' in d) || (d.batchId is string && d.batchId.matches('^[0-9]{1,20}$')))
        && (!('multiCourseGroupId' in d) || (d.multiCourseGroupId is string && d.multiCourseGroupId.matches('^[0-9]{1,20}$')));
    }

    // 教師自建「自我調課」紀錄（substituteRecords create 的教師分支）的完整驗證。
    // 合法形狀來源：v2-app.js writeV2Record 的 payload（record + resolveApproverInfo ids +
    // initiatedBy/initiatedByName）加上 createSubstituteRecord 的 semesterId／createdAt／
    // approvedAt、writeV2Record 的 status／initiatedByRole。
    // 禁止：approvedBy／approvedByName／fromRequestId／isLegacy／migratedFrom 等稽核性欄位，以及
    // 保留欄位 recordId／reqId（前端讀取時以 { recordId: d.id, ...d.data() } 展開，文件內的同名欄位
    // 會覆蓋真正的 doc id）——全部由 hasOnly 白名單擋下。`id` 是前端 V1 遺留的批次排序鍵
    // （v2-app.js 依 id 的 _序號 排序同批調課單），有合法用途，所以保留（字元集見 hasSafeCaseText）。
    function isValidSelfSwapRecord(schoolId, d) {
      let me = myTeacherId(schoolId);
      return me != ''
        && d.keys().hasOnly(['id', 'type', 'date', 'swapDate', 'weekday', 'period', 'className', 'subject', 'domain',
             'originalTeacher', 'swapWeekday', 'swapPeriod', 'swapTeacher', 'swapSubject', 'swapDomain', 'substituteTeacher',
             'docNumber', 'isSelfSwap', 'isMultiSwap', 'batchId', 'batchSize',
             'originalTeacherId', 'substituteTeacherId', 'swapTeacherId',
             'additionalConsentTeacherIds', 'requiredApproverId', 'requiredApproverName',
             'requestType', 'initiatedBy', 'initiatedByName', 'initiatedByRole', 'status',
             'approvedAt', 'createdAt', 'semesterId', 'affectedTeacherIds'])
        && d.isSelfSwap == true
        && d.type in ['調課', 'swap']
        && d.originalTeacherId == me && d.swapTeacherId == me && d.substituteTeacherId == me
        && hasSafeCaseText(d)
        && hasValidCaseIds(d)
        // P4b：initiatedBy 必帶且等於本人（前端 writeV2Record 的自我調課路徑一律寫入）。原本 get('initiatedBy', me)
        // 允許省略，讓前端以「批次發起者」過濾同批紀錄（batchGuard.js）的防線可被繞過。
        && 'initiatedBy' in d && d.initiatedBy == me
        && d.get('status', 'approved') == 'approved'
        && d.get('initiatedByRole', 'teacher') == 'teacher'
        && d.get('requestType', 'substitute') in ['substitute', 'swap']
        && d.get('requiredApproverId', null) == null
        && d.get('additionalConsentTeacherIds', []).size() == 0
        && d.get('affectedTeacherIds', []).hasOnly([me])
        && isRecentIsoString(d.createdAt)
        && (!('approvedAt' in d) || isRecentIsoString(d.approvedAt))
        && isSelfSwapNamesOk(schoolId, d);
    }

    // 自我調課紀錄裡的姓名欄位必須是本人姓名（前端的 id 由名冊姓名反查而來，自我調課三個 id 都是本人，
    // 姓名因此必為本人姓名；擋下 originalTeacher 填別人姓名偽造受害者紀錄，審計 M6(a)）。
    function isSelfSwapNamesOk(schoolId, d) {
      let myName = myTeacherDoc(schoolId).name;
      return d.get('originalTeacher', myName) == myName
        && d.get('swapTeacher', myName) == myName
        && d.get('substituteTeacher', myName) == myName;
    }

    // pendingRequests create（教師與 approver 兩條分支共用的「內容形狀」驗證）。
    // 欄位 = 自我調課紀錄的內容欄位 + 狀態機欄位（requestType／status／pendingConsentTeacherIds／
    // swapConsents）；不含 approvedBy／approvedAt／approvedByName（建立時禁帶，hasOnly 已涵蓋）。
    // requestType 與 type 必須一致：substitute ↔ 代課；swap／multi_swap ↔ 調課。
    // 已知未做（運算式額度不足）：審計 M6(b) 的「姓名與 teacherId 交叉比對」（需對 3 位教師各 get 一次）。
    function isValidPendingRequestCreate(d) {
      return d.keys().hasOnly(['id', 'type', 'date', 'swapDate', 'weekday', 'period', 'className', 'subject', 'domain',
             'originalTeacher', 'swapWeekday', 'swapPeriod', 'swapTeacher', 'swapSubject', 'swapDomain', 'substituteTeacher',
             'docNumber', 'isSelfSwap', 'isMultiSwap', 'isMultiCourse', 'multiCourseGroupId', 'multiCourseIndex', 'multiCourseTotal',
             'batchId', 'batchSize',
             'originalTeacherId', 'substituteTeacherId', 'swapTeacherId', 'requiredApproverId', 'requiredApproverName',
             'requestType', 'status', 'pendingConsentTeacherIds', 'swapConsents',
             'initiatedBy', 'initiatedByName', 'createdAt', 'semesterId', 'affectedTeacherIds', 'hasDetail'])
        && d.initiatedBy is string
        && d.get('hasDetail', true) is bool
        && hasSafeCaseText(d)
        && hasValidCaseIds(d)
        && d.requestType in ['substitute', 'swap', 'multi_swap']
        && (d.requestType == 'substitute' ? d.get('type', '') == '代課' : d.get('type', '') in ['調課', 'swap'])
        && idList20(d.pendingConsentTeacherIds)
        && d.get('swapConsents', {}) is map && d.get('swapConsents', {}).size() <= 20
        && d.get('isSelfSwap', false) is bool
        && isRecentIsoString(d.createdAt)
        && (!('affectedTeacherIds' in d) || (d.affectedTeacherIds is list && d.affectedTeacherIds.size() <= 20
              && d.affectedTeacherIds.hasOnly([d.initiatedBy, d.get('requiredApproverId', ''), d.get('originalTeacherId', ''),
                   d.get('substituteTeacherId', ''), d.get('swapTeacherId', '')].concat(d.pendingConsentTeacherIds))));
    }

    // pendingRequests create 的教師分支：發起人必須是本人 + 狀態機初始狀態（Phase 3 既有規則，
    // 原本內嵌在 match 區塊，抽成函式以便只取一次 me）。swapConsents 建立時必須為空。
    function isTeacherPendingCreate(schoolId, d) {
      let me = myTeacherId(schoolId);
      return me != ''
        && d.initiatedBy == me
        && d.get('swapConsents', {}).size() == 0
        && (
          // v2.20：代課改為雙簽——初始狀態必須是 pending_swap_consent，同意名單恰為代課教師一人，
          // 且代課教師不可是發起人本人（封掉 create 就自帶 pending_approval 跳過代課教師同意）。
          (
            d.requestType == 'substitute'
            && d.status == 'pending_swap_consent'
            && d.get('substituteTeacherId', '') is string
            && d.get('substituteTeacherId', '') != ''
            && d.substituteTeacherId != d.initiatedBy
            && d.pendingConsentTeacherIds == [d.substituteTeacherId]
          )
          || (
            d.requestType in ['swap', 'multi_swap']
            && d.status == 'pending_swap_consent'
            && d.pendingConsentTeacherIds.size() > 0
            // 同意名單不可含發起人本人（封掉「自列唯一同意人再自我同意」跳過對方同意）
            && !d.pendingConsentTeacherIds.hasAny([d.initiatedBy])
          )
        );
    }

    // 同意人在 swapConsents 裡寫入的自己那一筆（前端寫 { consentedAt: ISO }，舊測試資料為字串）。
    function isValidConsentEntry(v) {
      return (v is string && v.size() <= 40)
        || (v is map && v.keys().hasOnly(['consentedAt']) && v.consentedAt is string && v.consentedAt.size() <= 40);
    }

    // M1 修補：同意人（pendingConsentTeacherIds 內的一員）的 update 只能「以自己的身分前進一步」：
    //   同意：pendingConsentTeacherIds 恰好等於「原名單扣掉自己」；swapConsents 只准新增／變動
    //         自己那一筆；名單清空 ⇔ status 轉 pending_approval（名單未清空則 status 不變）。
    //   拒絕：status → rejected，且不得觸碰 pendingConsentTeacherIds／swapConsents。
    // 舊資料相容：沒有 pendingConsentTeacherIds 欄位的 legacy 文件，以 requiredApproverId 當成
    // 單一成員名單（與前端 normalizeLegacyRequest 一致）。
    function isValidConsenterUpdate(schoolId) {
      let me = myTeacherId(schoolId);
      let nd = request.resource.data;
      let od = resource.data;
      let oldList = od.get('pendingConsentTeacherIds', [od.get('requiredApproverId', '')]);
      return me != ''
        && oldList is list && oldList.hasAny([me])
        && od.status in ['pending', 'pending_swap_consent']
        && (
          (
            nd.diff(od).affectedKeys().hasOnly(['status', 'pendingConsentTeacherIds', 'swapConsents', 'statusUpdatedAt'])
            && nd.pendingConsentTeacherIds is list
            && nd.pendingConsentTeacherIds.toSet() == oldList.toSet().difference([me].toSet())
            && nd.pendingConsentTeacherIds.size() == oldList.size() - 1
            && nd.swapConsents is map
            && nd.swapConsents.diff(od.get('swapConsents', {})).affectedKeys().hasOnly([me])
            && isValidConsentEntry(nd.swapConsents[me])
            && (nd.pendingConsentTeacherIds.size() == 0 ? nd.status == 'pending_approval' : nd.status == od.status)
            && isRecentIsoString(nd.statusUpdatedAt)
          )
          || (
            nd.diff(od).affectedKeys().hasOnly(['status', 'rejectedAt', 'rejectedBy', 'rejectedByName', 'rejectNote', 'statusUpdatedAt'])
            && nd.status == 'rejected'
            && nd.rejectedBy == me
            && isRecentIsoString(nd.rejectedAt) && isRecentIsoString(nd.statusUpdatedAt)
            && (string(nd.get('rejectedByName', '')) + string(nd.get('rejectNote', ''))).size() <= 600
          )
        );
    }

    // approver 的 update：只能做「核准（僅 pending_approval → approved）」與「駁回」兩件事，
    // 不得觸碰同意名單與同意紀錄（原規則的 affectedKeys 白名單含 pendingConsentTeacherIds／
    // swapConsents，讓組長可以不經對方同意把待同意的申請推進到待核准，與 M1 同源）。
    // 核准者必須是自己（approvedBy／rejectedBy == 登入者 mapping 的 teacherId），不得掛別人名字。
    // approver 若同時是待同意人，走 isValidConsenterUpdate（前端 consentRequest 本來就是同意人身分）。
    // v2.12b（M-1）：approver 的欄位只在「對應的狀態轉換」時才可寫，且時間欄位須為近期 ISO：
    //   - 狀態不變：不得有任何欄位變動（原版只限欄位集合，狀態不變時可任意改寫 approvedBy／
    //     rejectedBy／rejectNote，覆寫核准軌跡或注入內容）。
    //   - → approved（僅 pending_approval 起）：只能寫 status／approvedAt／approvedBy／
    //     approvedByName／statusUpdatedAt，approvedBy 必須是自己。
    //   - → rejected：只能寫 status／rejectedAt／rejectedBy／rejectedByName／rejectNote／
    //     statusUpdatedAt，rejectedBy 必須是自己。
    // v2.17（SB-I7 職務分離）：approver 不可核准 initiatedBy 是自己的申請，唯一例外是 isSelfOnlyRequest（自我調課、
    // 換走與換進的教師都是本人、沒有其他同意人）。「自己」＝登入者 uid（platformAdmin 的前端身分 teacherId 就是 uid）
    // 或登入者 mapping 的 teacherId；兩者都比，platformAdmin 同時是成員時也不能換個身分核准自己發起的申請。
    // 駁回不受限（發起人駁回自己的申請等同撤回，無風險）。approvedBy／rejectedBy 必須是本人（isActorId，不可掛別人名字）。
    // 組長代教師發起：initiatedBy＝被代發的教師，不是核准者本人，不受此限。
    function isActorId(me, id) {
      return id is string && ((me != '' && id == me) || (isPlatformAdmin() && id == request.auth.uid));
    }

    function isSelfOnlyRequest(od, id) {
      return od.get('isSelfSwap', false) == true
        && od.get('originalTeacherId', null) == id
        && od.get('swapTeacherId', null) in [null, id]
        && od.get('substituteTeacherId', null) in [null, id]
        && od.get('pendingConsentTeacherIds', []).size() == 0
        && od.get('requiredApproverId', null) in [null, id];
    }

    function isOwnRequestBlocked(od, me) {
      let ini = od.get('initiatedBy', '');
      return (ini == request.auth.uid || ini == me) && !isSelfOnlyRequest(od, ini);
    }

    // 核准／駁回時的「本人」檢查（approvedBy／rejectedBy 必須是本人；核准另需通過職務分離）。me 只在狀態真的轉換時才求值
    // （規則的 let 是即時求值，不放在 isValidApproverUpdate 開頭，避免同意人更新等其他路徑白白多算一次 myTeacherId）。
    function approvalActorOk(schoolId, nd, od) {
      let me = myTeacherId(schoolId);
      return (nd.status != 'approved' || (isActorId(me, nd.approvedBy) && !isOwnRequestBlocked(od, me)))
        && (nd.status != 'rejected' || isActorId(me, nd.rejectedBy));
    }

    function isValidApproverUpdate(schoolId) {
      let nd = request.resource.data;
      let od = resource.data;
      let ak = nd.diff(od).affectedKeys();
      return (
          (nd.status == od.status && ak.size() == 0)
          || (
            nd.status == 'approved' && od.status == 'pending_approval'
            && ak.hasOnly(['status', 'approvedAt', 'approvedBy', 'approvedByName', 'statusUpdatedAt'])
            && nd.approvedByName is string && nd.approvedByName.size() <= 100
            && isRecentIsoString(nd.approvedAt) && isRecentIsoString(nd.statusUpdatedAt)
          )
          || (
            nd.status == 'rejected' && od.status in ['pending', 'pending_swap_consent', 'pending_approval']
            && ak.hasOnly(['status', 'rejectedAt', 'rejectedBy', 'rejectedByName', 'rejectNote', 'statusUpdatedAt'])
            && nd.rejectedByName is string && nd.rejectedByName.size() <= 100
            && nd.rejectNote is string && nd.rejectNote.size() <= 500
            && isRecentIsoString(nd.rejectedAt) && isRecentIsoString(nd.statusUpdatedAt)
          )
        )
        && isApprover(schoolId)
        && (nd.status == od.status || approvalActorOk(schoolId, nd, od));
    }

    // 稽核日誌 create 的完整驗證（M3）。對齊 operationLogger.log() 實際寫入的 7 個欄位：
    // timestamp／actor{uid,email,name,role,teacherId}／action／targetType／targetId／details／semesterId。
    // actor 必須就是登入者本人（uid、teacherId、email、姓名皆與登入者一致）——否則任何成員都能
    // 以他人名義寫入永久不可刪的稽核紀錄。
    // v2.12b（H-2）：details 規則語言無法遞迴檢查巢狀內容大小，且日誌不可刪，所以改成「單一限長
    // JSON 字串」（≤10000 字元；前端 operationLogger 序列化並截斷）。舊資料的 map 形狀仍可讀取；
    // 新寫入只接受 null、空 map（相容既有測試／fixture）或字串。
    // 注意：姓名須等於教師檔現行姓名；若主任在某教師登入期間改了他的姓名，該教師在重新登入前的
    // 日誌寫入會被拒（日誌寫入失敗不阻擋業務流程，會在操作日誌頁籤顯示寫入失敗橫幅）。
    function isValidOperationLog(schoolId, d) {
      let me = myTeacherId(schoolId);
      // v2.17：platformAdmin（可以不是成員、沒有教師檔）以 uid 當 teacherId 寫日誌（actor.name 為自訂字串、role 只能是 director／空）；
      // 成員身分與 platformAdmin 身分兩條分支任一成立即可（同時是成員的 platformAdmin 兩種都能寫）。
      return (me != '' || isPlatformAdmin())
        && d.keys().hasOnly(['action', 'actor', 'timestamp', 'targetType', 'targetId', 'details', 'semesterId'])
        && d.action is string && d.action.matches('^[a-z0-9_]{1,64}$')
        && isRecentIsoString(d.timestamp)
        && d.targetType is string && d.targetType.matches('^[A-Za-z0-9_]{1,50}$')
        && (d.targetId == null || (d.targetId is string && d.targetId.matches('^[A-Za-z0-9_.:-]{1,128}$')))
        && (d.details == null || (d.details is map && d.details.size() == 0) || (d.details is string && d.details.size() <= 10000))
        && (string(d.get('semesterId', '')).size() <= 20)
        && d.actor is map
        && d.actor.keys().hasOnly(['uid', 'email', 'name', 'role', 'teacherId'])
        && d.actor.get('uid', request.auth.uid) == request.auth.uid
        && d.actor.get('email', null) in [null, userEmail().lower()]
        && (
          (me != ''
            && d.actor.teacherId == me
            && d.actor.get('name', null) == myTeacherDoc(schoolId).name
            && actorRoleOk(schoolId, d.actor.get('role', null)))
          || (isPlatformAdmin()
            && d.actor.teacherId == request.auth.uid
            && string(d.actor.get('name', '')).size() <= 100
            && d.actor.get('role', null) in [null, 'director'])
        );
    }

    // v2.12b（M-2）：actor.role 須與登入者教師檔的 role 一致（舊 'admin' 視同 'director'，與前端
    // normalizeRole 一致）；白名單主任在教師檔 role 尚未升級為 director 的空檔也可寫 'director'
    // （isInitialDirector 只在前面比對都不符時才會被評估，一般情況不增加運算式成本）。
    function actorRoleOk(schoolId, r) {
      let docRole = myTeacherDoc(schoolId).get('role', 'teacher');
      return r == null || r == docRole
        || (r == 'director' && (docRole == 'admin' || isInitialDirector(schoolId)));
    }

    // 本人自建 userMappings 的欄位驗證（H1 修補的一部分）。欄位 = authGuardV2 buildMappingPatch
    // （email／googleName／googlePhotoUrl／lastProviderId）+ linkedTeacherId + upsertUserMapping 的
    // lastLoginAt；updatedAt 是正式庫既有 mapping 文件已存在的欄位（merge 寫入時整份合併後仍須通過）。
    function isValidSelfMapping(schoolId, d) {
      return d.keys().hasOnly(['linkedTeacherId', 'email', 'googleName', 'googlePhotoUrl', 'lastProviderId', 'lastLoginAt', 'updatedAt'])
        && teacherEmailMatches(schoolId, d.get('linkedTeacherId', null))
        && d.get('email', userEmail().lower()) in [null, userEmail().lower()]
        && (string(d.get('googleName', '')) + string(d.get('googlePhotoUrl', '')) + string(d.get('lastProviderId', ''))
             + string(d.get('lastLoginAt', '')) + string(d.get('updatedAt', '')) + d.linkedTeacherId).size() <= 1500;
    }

    // V1 個人雲端備份（users/{uid}/data/substituteSystem）的欄位約束（M4）。欄位 =
    // dataManager.exportForSync() 的 8 個鍵 + uploadToCloud 補上的 lastModified／version。
    function isValidV1Backup(d) {
      return d.keys().hasOnly(['schoolName', 'scheduleData', 'teachers', 'classes', 'substituteRecords', 'settings', 'lastModified', 'version'])
        && d.get('schoolName', '') is string && d.get('schoolName', '').size() <= 200
        && d.get('lastModified', '') is string && d.get('lastModified', '').size() <= 40
        && d.get('version', 0) is number
        && d.get('scheduleData', []) is list && d.get('scheduleData', []).size() <= 20000
        && d.get('teachers', []) is list && d.get('teachers', []).size() <= 2000
        && d.get('classes', []) is list && d.get('classes', []).size() <= 500
        && d.get('substituteRecords', []) is list && d.get('substituteRecords', []).size() <= 20000
        && d.get('settings', {}) is map && d.get('settings', {}).size() <= 50;
    }

    // ---- private/detail 子文件共用邏輯（Phase 6：敏感欄位私有化）----
    // leaveType/leaveTypeName/reason 搬到 substituteRecords/pendingRequests 底下的
    // private/detail 子文件，文件自帶 allowedTeacherIds（當事人清單），規則不需 get()
    // 父文件即可判斷可讀性，成本低且沒有寫入順序限制。
    function hasPrivateDetailAccess(schoolId, data) {
      return isApprover(schoolId)
        || (myTeacherId(schoolId) != '' && myTeacherId(schoolId) in data.allowedTeacherIds);
    }

    // v2.12（M5）：補欄位長度上限；ACL 清單最多 30 人（multi_swap 全員 + 發起人 + 核准者綽綽有餘）。
    // v2.12b（H-1c）：ACL「元素」的型別／長度檢查（idList30，約 130 個運算式）不放在這裡，而是由各 match
    // 區塊在需要的分支呼叫——教師分支的 ACL 已被限定為 [本人]，不必再檢查；approver／pending 分支才要。
    function isValidPrivateDetailWrite(data) {
      return data.keys().hasOnly(['leaveType', 'leaveTypeName', 'reason', 'allowedTeacherIds'])
        && data.allowedTeacherIds is list && data.allowedTeacherIds.size() <= 30
        && string(data.get('leaveType', '')).size() <= 50 && string(data.get('leaveTypeName', '')).size() <= 50
        && string(data.get('reason', '')).size() <= 2000;
    }

    // 驗收修復（阻斷 2，substituteRecords/private/detail update 這一半）：private/detail
    // 本身沒有自己的 semesterId 欄位（假別/事由只是父文件的敏感欄位分身），必須讀父文件
    // substituteRecords/{recordId} 才能判斷歷史學期唯讀鎖是否適用——否則父文件已被鎖住
    // 唯讀，這個子文件卻還能被 approver 任意編輯，等於鎖了一半。這是這條路徑新增的唯一一次
    // 額外 get()（既有的 hasPrivateDetailAccess() 只讀請求/資源自身欄位，不曾讀父文件）；
    // update 動作本身頻率低（假別/事由編輯），多一次讀取成本可接受。相容期保護與父文件同款：
    // 父文件沒有 semesterId 欄位（回填腳本尚未執行）時放行，等同 Stage 2 之前的行為。
    // ⚠ 驗收修復（R5，opus 重驗）：只給 update 用，不可直接套用在 create——若父文件根本不
    // 存在（見下方 parentAllowsNewPrivateDetail() 的說明，create 流程本來就會先寫 private/
    // detail、後寫父文件），`get(...).data` 會對不存在的文件求值錯誤，Firestore 規則對求值
    // 錯誤的處理是讓整條件視為不成立（fail-closed／deny）。這裡刻意接受這個行為：對
    // update 而言，「父文件不存在」代表資料本身已經處於異常狀態（正常流程走到能被
    // update 的地步，父文件必然早就寫入完成），拒絕是合理的保守選擇，不需要額外用
    // exists() 檢查放寬。
    function parentSubstituteRecordCurrentSemester(schoolId, recordId) {
      let parent = get(/databases/$(database)/documents/schools/$(schoolId)/substituteRecords/$(recordId)).data;
      return !('semesterId' in parent) || isCurrentOrFutureSemester(schoolId, parent.semesterId);
    }

    // 驗收修復（R2，opus 重驗）：private/detail 的 create 也要擋「approver 為已鎖定的歷史
    // 紀錄事後補建 leaveType，藉此影響結算」這條路徑（原版只鎖了 update，沒鎖 create——
    // 一筆歷史紀錄若當初建立時沒有敏感欄位（hasSensitive===false，未建立 private/detail），
    // approver 理論上可以事後對它「補建」一份帶 leaveType 的 private/detail，讓月結算把
    // 原本不會扣減時數的假別／不影響時數的調課，錯誤地變成會扣減，等於繞過歷史學期唯讀
    // 鎖竄改結算結果）。
    // 與 update 版本（parentSubstituteRecordCurrentSemester）刻意不同的是「父文件不存在」的
    // 處理方式：schoolDataService.createSubstituteRecord() 與 pendingRequestService.
    // approveRequest() 皆先寫 private/detail、後寫父文件（避免留下「父文件存在但私有明細
    // 遺失」的半套狀態，見兩處各自的檔頭註解）——對「全新紀錄正在建立中」這個正常流程而言，
    // private/detail 的 create 發生當下，父文件本來就還不存在，若比照 update 版本讓「父文件
    // 不存在」評估錯誤而拒絕，會讓所有新紀錄（自我調課／approver 核准／legacy 遷移）的建立
    // 整批失敗。因此這裡改用 exists() 先短路：
    //   - 父文件不存在 → 視為「這是全新紀錄建立流程，尚未輪到父文件」，放行。
    //   - 父文件存在但缺 semesterId（回填前舊資料）→ 放行（相容期，同各處 isCurrentSemester）。
    //   - 父文件存在且 semesterId 不是目前學期 → 拒絕（這正是要擋的「事後補建」情境）。
    // 這是這條路徑新增的唯一一次額外 exists()/get()（原本的 create 規則只讀請求/資源自身
    // 欄位），create 動作本身頻率不高，成本可接受。
    function parentAllowsNewPrivateDetail(schoolId, recordId) {
      return !exists(/databases/$(database)/documents/schools/$(schoolId)/substituteRecords/$(recordId))
        || !('semesterId' in get(/databases/$(database)/documents/schools/$(schoolId)/substituteRecords/$(recordId)).data)
        || isCurrentOrFutureSemester(schoolId, get(/databases/$(database)/documents/schools/$(schoolId)/substituteRecords/$(recordId)).data.semesterId);
    }

    // v2.12（M2）：教師自建 substituteRecords/private/detail 時，父文件必須「尚未存在」或「是本人的
    // 自我調課」。見 substituteRecords/private 區塊註解。
    function parentIsOwnSelfSwapOrAbsent(schoolId, recordId) {
      return !exists(/databases/$(database)/documents/schools/$(schoolId)/substituteRecords/$(recordId))
        || (
          get(/databases/$(database)/documents/schools/$(schoolId)/substituteRecords/$(recordId)).data.get('isSelfSwap', false) == true
          && get(/databases/$(database)/documents/schools/$(schoolId)/substituteRecords/$(recordId)).data.get('originalTeacherId', '') == myTeacherId(schoolId)
        );
    }

    // v2.12（M2）：pendingRequests/private/detail 的非 approver create——父文件不存在
    // （前端先寫 private 再寫父文件）或父文件的發起人就是本人。
    function parentIsOwnRequestOrAbsent(schoolId, reqId) {
      return !exists(/databases/$(database)/documents/schools/$(schoolId)/pendingRequests/$(reqId))
        || get(/databases/$(database)/documents/schools/$(schoolId)/pendingRequests/$(reqId)).data.get('initiatedBy', '') == myTeacherId(schoolId);
    }

    // ---- Stage 5 驗收修復（中5，opus 驗收）----
    // pendingRequests/{reqId}/private/detail 原本完全沒有學期鎖（update 規則只驗
    // isApprover(schoolId)）——與 substituteRecords 側在 Stage 2 就已經補上的歷史學期唯讀鎖
    // （parentSubstituteRecordCurrentSemester／parentAllowsNewPrivateDetail，見上）不對稱，
    // approver 理論上仍可對歷史學期的 pendingRequests 私有明細（假別/事由）任意補建/竄改，
    // 與 substituteRecords 側 R2 修復要擋的問題同一類（歷史紀錄的假別若被事後竄改，會影響
    // 月結算是否扣減時數）。寫法完全比照 substituteRecords 側兩個函式，唯一差異是讀
    // pendingRequests/{reqId} 而非 substituteRecords/{recordId}——pendingRequests 的 create
    // 已鎖 semesterId==目前學期（見下方 match /pendingRequests/{reqId} 的 create 規則），
    // 故新請求的私有明細建立時父文件的 semesterId 必然是目前學期，這兩個函式主要在擋
    // 「歷史學期的 pendingRequests 被事後補建/竄改私有明細」。
    function parentPendingRequestCurrentSemester(schoolId, reqId) {
      let parent = get(/databases/$(database)/documents/schools/$(schoolId)/pendingRequests/$(reqId)).data;
      return !('semesterId' in parent) || isCurrentOrFutureSemester(schoolId, parent.semesterId);
    }

    function parentAllowsNewPendingRequestPrivateDetail(schoolId, reqId) {
      return !exists(/databases/$(database)/documents/schools/$(schoolId)/pendingRequests/$(reqId))
        || !('semesterId' in get(/databases/$(database)/documents/schools/$(schoolId)/pendingRequests/$(reqId)).data)
        || isCurrentOrFutureSemester(schoolId, get(/databases/$(database)/documents/schools/$(schoolId)/pendingRequests/$(reqId)).data.semesterId);
    }

    // v2.17（SB-L9）：config/main.directorEstablished 的單向閘。新值必須是布林；舊值為 true 時新值必須仍為 true。
    // 只在 config 寫入時評估（不在熱路徑）。resource 為 null＝create。
    function directorFlagKept(docId) {
      return docId != 'main'
        || (request.resource.data.get('directorEstablished', false) is bool
            && (resource == null
                || resource.data.get('directorEstablished', false) != true
                || request.resource.data.get('directorEstablished', false) == true));
    }

    // ================ V2: schools/{schoolId} ================

    match /schools/{schoolId} {
      // 學校根佔位文件（Stage 0 R1：任何登入者可讀會讓別校 schoolId 被探測，改為成員限定）
      allow read:  if canReadSchool(schoolId);
      allow write: if isDirector(schoolId);

      // ----- 設定（學校名稱、白名單） -----
      match /config/{docId} {
        // Stage 0 R2：成員或白名單初始主任可讀（後者靠 isInitialDirector 內部 get()
        // 繞過本 read 規則，白名單主任首登仍讀得到，見 isMemberOrBootstrapDirector 定義）
        // v2.17：platformAdmin 可讀任何學校的 config（isMemberOrBootstrapDirector 的 isPlatformAdmin 分支；
        // config/settlement 另走 isApprover，platformAdmin 也成立）。這取代 Stage 4 原設計「platformAdmin 不能讀
        // 學校 config」——使用者 2026-11-17 決定把 platformAdmin 升為全系統最高管理員，見檔頭第 18 點。
        // v2.8：config/settlement 內含日曆 API key，僅 approver 可讀（一般教師讀取一律拒絕）；
        // 其他 config 文件讀取維持原狀。isApprover 含 isInitialDirector，白名單主任首登仍可讀。
        allow read:  if isMemberOrBootstrapDirector(schoolId)
          && (docId != 'settlement' || isApprover(schoolId));
        // 僅 director 可改學校名稱、白名單（不含 settlement，settlement 走下方有欄位驗證的規則）
        // v2.17（SB-L9）：config/main.directorEstablished 旗標只進不退——一旦為 true，任何 client（含主任、platformAdmin）
        // 都不可改回 false、改成非布林或把整個欄位拿掉（整份覆寫、merge 缺欄位皆算），也不可刪除 config/main
        // （刪掉再重建就能重開白名單）。旗標只可由 Admin 腳本（owner 憑證，不受 rules）重設。
        // v2.19：通用規則排除 recordsLock 與 grade9——這兩份文件有專屬規則（序號只能 +1、grade9 欄位白名單），
        // 否則主任可經由本條把 seq 寫成任意值（含回退）或不經白名單寫 grade9。
        allow create, update: if isDirector(schoolId) && docId != 'settlement' && docId != 'recordsLock' && docId != 'grade9' && directorFlagKept(docId);
        // v2.19：delete 也排除 recordsLock，否則可「刪除再以 seq=1 重建」回退序號（前端沒有刪除 recordsLock 的路徑）。
        allow delete: if isDirector(schoolId) && docId != 'recordsLock'
          && (docId != 'main' || resource.data.get('directorEstablished', false) != true);
        // v2.14（P6）：成立紀錄的序號鎖（見檔頭第 15 點，含涵蓋範圍與例外）。approver 可寫；seq 只能從無到 1、之後每次剛好加 1。
        // 本規則不檢查「新增紀錄是否同交易遞增 seq」，那是前端協定；教師自我調課、備份還原、舊資料遷移不遞增 seq。
        allow create, update: if docId == 'recordsLock'
          && isApprover(schoolId)
          && request.resource.data.keys().hasOnly(['seq', 'updatedAt'])
          && request.resource.data.keys().hasAll(['seq', 'updatedAt'])
          && request.resource.data.seq is int
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 40
          && (resource == null
              ? request.resource.data.seq == 1
              : request.resource.data.seq == resource.data.seq + 1);
        // v2.15（P7）：九年級畢業設定。成員可讀（沿用上方 read 規則）；只有 approver 可寫，欄位白名單與長度上限。
        allow create, update: if docId == 'grade9'
          && isApprover(schoolId)
          && request.resource.data.keys().hasOnly(['semesterId', 'enabled', 'effectiveDate', 'updatedAt', 'updatedBy'])
          && request.resource.data.keys().hasAll(['semesterId', 'enabled', 'effectiveDate', 'updatedAt', 'updatedBy'])
          && request.resource.data.semesterId is string
          && request.resource.data.semesterId.size() <= 20
          && request.resource.data.enabled is bool
          && request.resource.data.effectiveDate is string
          && request.resource.data.effectiveDate.size() <= 10
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 40
          && request.resource.data.updatedBy is string
          && request.resource.data.updatedBy.size() <= 100;
        // v2.8：月結算週數設定（config/settlement）開放 approver（含 section_chief、director）
        // 建立與更新，含欄位白名單、型別與大小檢查；不含 delete。
        // updatedBy 須為本人 email 或 uid（client 寫 email || uid）；updatedAt 為 ISO 字串。
        allow create, update: if docId == 'settlement'
          && isApprover(schoolId)
          && request.resource.data.keys().hasOnly(
               ['calendarId', 'calendarApiKey', 'weeksByYear', 'weeklyBaseByTeacher', 'updatedAt', 'updatedBy'])
          && request.resource.data.keys().hasAll(
               ['calendarId', 'calendarApiKey', 'weeksByYear', 'updatedAt', 'updatedBy'])
          && request.resource.data.calendarId is string
          && request.resource.data.calendarId.size() <= 256
          && request.resource.data.calendarApiKey is string
          && request.resource.data.calendarApiKey.size() <= 128
          && request.resource.data.weeksByYear is map
          && request.resource.data.weeksByYear.size() <= 20
          // v2.15（P7）：逐人超鐘點門檻（可選欄位）。{ 教師姓名或 teacherId: 每週基本節數 }，只有 approver 可寫。
          // 規則無法逐項檢查 map 的值型別，這裡只限制為 map 且不超過 400 筆；數值合法性由前端與結算端驗證（非數字、負數一律退回預設 20）。
          && (!('weeklyBaseByTeacher' in request.resource.data)
              || (request.resource.data.weeklyBaseByTeacher is map
                  && request.resource.data.weeklyBaseByTeacher.size() <= 400))
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 40
          && request.resource.data.updatedBy is string
          && (request.resource.data.updatedBy == request.auth.uid
              || ('email' in request.auth.token
                  && request.resource.data.updatedBy.lower() == request.auth.token.email.lower()));
        // Stage 4（多租戶開通，§4.2-4.4）：platformAdmin 核准學校申請時，代為建立全新學校的
        // config/main（initialAdminEmails=[申請者 email]）。（v2.17 註：這條 create 分支現在是冗餘的——platformAdmin
        // 已是 isDirector 的一員，上面的 create/update 規則就放行；保留它只為不改動 Stage 4 的驗證形狀 isValidNewSchoolConfigWrite。）
        // 原設計「僅 create、對已存在學校寫入會被判成 update 而被拒」的 schoolId 衝突防線在 v2.17 已不成立：
        // platformAdmin 現在對既有學校的 config/main 也有 update 權限，所以「不得覆寫既有學校」改由前端
        // schoolApplicationService.approveApplication() 在 transaction 內先讀、已存在就中止（見該函式註解）。
        // 兩條分支（isDirector 與本分支）對 platformAdmin 可同時成立，Firestore 對同一操作任一條 allow 通過即放行。
        // opus 驗收 L2：補 `docId == 'main'`——原版只驗證了 request.resource.data 的內容，
        // 沒有限制 platformAdmin 可以對 config/ 底下「哪一個」docId 寫入；雖然目前 client
        // 只會呼叫 configDocForSchool() 組出 .../config/main，但規則本身應該獨立於「client
        // 目前恰好只這樣呼叫」這個事實成立，直接鎖死唯一合法的 docId 值，杜絕未來任何呼叫
        // 端誤植路徑、或 platformAdmin 帳號被盜用後對 config/ 底下灌入其他文件。
        allow create: if isPlatformAdmin()
          && docId == 'main'
          && isValidNewSchoolConfigWrite(request.resource.data);
      }

      // ----- Email 索引（首登配對用，Stage 0 R3 配套，§3.4a） -----
      // schools/{schoolId}/emailIndex/{emailKey}：emailKey = 登入 email（小寫）。
      // 文件內容只有 { teacherId }，不含姓名等個資。只開放 get（單文件讀），不開放 list，
      // 避免被整包撈走 email → teacherId 對照表；get 與 list 在 Firestore 規則中可分開授權。
      // 驗收修復 S5：get 端用 userEmail().lower() 比對——emailKey 一律小寫儲存
      // （schemaConstants.emailIndexDoc 正規化），但 Google token 的 email 大小寫
      // 不保證與儲存值一致，用 .lower() 才不會讓合法擁有者查自己都被拒。
      // 驗收修復 S9：write 拆成 create/update（欄位白名單 hasOnly(['teacherId'])）
      // 與 delete（無 request.resource，不能套用 hasOnly 檢查）分開宣告。
      match /emailIndex/{emailKey} {
        // v2.12（H1）：加 isEmailVerified()——否則未驗證的搶註帳號可用受害者 email 查到 teacherId，
        // 作為自建 mapping 的第一步。
        allow get:    if isEmailVerified() && emailKey == userEmail().lower();
        allow list:   if isApprover(schoolId);
        allow create, update: if isDirector(schoolId)
                              && request.resource.data.keys().hasOnly(['teacherId']);
        allow delete: if isDirector(schoolId);
      }

      // ----- 首登被拒紀錄（login_denied 改道，Stage 0 R7 配套，§3.4b） -----
      // schools/{schoolId}/joinAttempts/{uid}：doc id 綁 uid，一人一份、可覆寫，
      // 天然限制灌爆量。取代原本寫進 operationLogs 的 login_denied（R7 收緊後，
      // 尚未成為成員的使用者恆無法通過 isMember，寫不進 operationLogs）。
      // 驗收修復 S3：
      //   - configExists(schoolId)：schoolId 必須對應一所真實存在的學校，防止任何登入者
      //     對任意自創的 schoolId 路徑無限量灌寫 joinAttempts 文件（該路徑本來就不需要
      //     成員資格，若不驗 schoolId 存在，會是一個不受限的免費寫入端點）。
      //   - 欄位型別與長度驗證，避免超長字串塞爆文件 / 灌垃圾資料。
      match /joinAttempts/{uid} {
        allow read:   if isApprover(schoolId);
        // Stage 4 opus 驗收 B3：補 isEmailVerified()——與 schoolApplications／userDirectory
        // 自寫分支的收緊方向一致（任意登入者皆可觸發的寫入端點都應要求 email 已驗證）。
        // 相容性：joinAttempts 只在「schoolId 已知」的失敗登入路徑才會被寫（見
        // authGuardV2.resolveIdentity()——B1 修復後，schoolId 完全未知時直接回傳 null、
        // 不寫任何 joinAttempts），未驗證 email 的使用者頂多是這筆稽核紀錄寫不進去
        // （logJoinAttempt() 吞掉錯誤、不阻擋既有的拒絕流程），不影響登入結果本身。
        allow create, update: if isSignedIn() && request.auth.uid == uid
                              && isEmailVerified()
                              && configExists(schoolId)
                              && request.resource.data.keys().hasOnly(['email', 'attemptedAt', 'reason'])
                              && request.resource.data.email is string
                              && request.resource.data.email.size() < 200
                              // v2.12（L2）：email 欄位須為登入者本人 email，不可偽造他人名義的拒絕紀錄
                              && request.resource.data.email == userEmail().lower()
                              && request.resource.data.attemptedAt is string
                              && request.resource.data.attemptedAt.size() <= 40
                              && request.resource.data.reason is string
                              && request.resource.data.reason.size() < 100;
        allow delete: if isDirector(schoolId);
      }

      // ----- 教師 -----
      match /teachers/{teacherId} {
        // Stage 0 R3：改為成員限定可讀（原「任何登入者」會讓他校教師名單被整批撈走）。
        // ⚠ 會打斷首登教師的 email 配對（尚無 mapping 時 isMember 為 false），
        // 配套是 §3.4a 的 emailIndex——authGuardV2.resolveIdentity 改成
        // 「先用 emailIndex 查到的 teacherId upsert mapping，再讀教師檔本體」，
        // 順序見 authGuardV2.js 內的說明。
        allow read: if canReadSchool(schoolId);

        // 建立：director；或初始主任第一次登入自建 director 教師檔（bootstrap）
        // Phase 3 資安收緊：isValidRoleValue() 併入驗證，杜絕寫入列舉外的 role 字串
        // 驗收修復 S5-R：teachers.email 一律小寫儲存（schoolDataService 正規化），
        // 用 userEmail().lower() 比對才不會讓 token email 大小寫不一致擋下合法 bootstrap。
        allow create: if (
            isDirector(schoolId)
            || (
              isInitialDirector(schoolId)
              && request.resource.data.email == userEmail().lower()
              && request.resource.data.role in ['director', 'admin']
            )
          )
          && isValidRoleValue(request.resource.data.role);

        // 更新：director；或初始主任把自己的教師檔升級為 director（bootstrap 補登）；
        //       section_chief 可改一般欄位但不能改 role 或 email；
        //       Phase 1.6.c：自己對應的 teacher doc 可改 authProvider（只准動該欄位 + updatedAt）
        // Phase 3 資安收緊：director / 初始主任 途徑一併驗證 isValidRoleValue()
        // 驗收修復 S5-R：同上，resource.data.email 是既有小寫儲存值，比對 userEmail().lower()
        allow update: if (
            (
              isDirector(schoolId)
              && isValidRoleValue(request.resource.data.role)
              // v2.9 護欄：主任不可改自己教師檔的 role（改別人 / 改自己其他欄位不受影響）
              && !(request.resource.data.role != resource.data.role
                   && myTeacherId(schoolId) == teacherId)
            )
            || (
              isInitialDirector(schoolId)
              && resource.data.email == userEmail().lower()
              && isValidRoleValue(request.resource.data.role)
            )
            || (
              // v2.16（PL-T1）：組長只能改教師管理頁會寫的欄位（domains／homeroomClass／partTime／updatedAt），
              // name／email／role 與其他欄位一律不可動（不論目標是不是主任）。
              isApprover(schoolId)
              && isValidChiefTeacherPatch(request.resource.data, resource.data)
            )
            || (
              isSignedIn()
              && myTeacherId(schoolId) == teacherId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authProvider', 'updatedAt'])
              // v2.12b（H-1d）：前端只會寫 providerData[0].providerId（google.com／password）與 ISO 的 updatedAt
              && request.resource.data.get('authProvider', 'password') in ['google.com', 'password']
              && isRecentIsoString(request.resource.data.updatedAt)
            )
          );

        // 刪除：只有 director 能刪教師；v2.16（SB-L8）主任不可刪除自己的教師檔，避免把自己鎖在系統外
        allow delete: if isDirector(schoolId) && myTeacherId(schoolId) != teacherId;
      }

      // ----- 全校課表（舊：單一文件，Stage 2 起僅供讀取 fallback，見下方 schedules） -----
      match /data/{docId} {
        // Stage 0 R4：改為成員限定可讀（原「任何登入者」會讓他校完整課表被下載）
        allow read:  if canReadSchool(schoolId);
        // Stage 2：schoolDataService.saveSchedule() 已改寫 schedules/{semesterId}，不再有任何
        // client 路徑寫入這個舊文件；write 規則維持不變（無成本，也不需要收緊——沒有寫入路徑
        // 可用，收緊與否不影響任何實際行為，維持原樣減少本次變更範圍）。
        // v2.12（L5）：改為禁止寫入。全 repo 已無任何 client 程式寫入此路徑（schoolDataService.
        // saveSchedule 寫 schedules/{semesterId}；遷移／備份腳本走 REST owner 憑證，不受 rules 限制），
        // 原本「approver 可無學期鎖、無欄位驗證地寫入」是多餘的攻擊面。
        allow write: if false;
      }

      // ----- 全校課表（Stage 2：per-semester 文件，取代上面的 data/{docId}） -----
      // schools/{schoolId}/schedules/{semesterId}：每學期各自一份文件，換學期不再覆蓋舊資料。
      match /schedules/{semesterId} {
        // 讀取：校內成員（含歷史學期——歷史課表仍可被全校成員唯讀查詢，供對照舊學期排課）
        allow read: if canReadSchool(schoolId);
        // 建立/更新：approver，且僅能寫「目前學期」那一份文件——歷史學期課表唯讀鎖（§6.1）。
        // semesterId 取自路徑本身（wildcard），不需讀 request.resource.data，成本同上方
        // isCurrentSemester() 的説明（相依文件 config/main 在同一請求的 isApprover() 判斷鏈
        // 中已被讀過一次，計費成本為 0）。
        // v2.13-A（已納入本檔）：create 改用 isCurrentSemesterAfter（見其定義），允許「開新學期」在同一次提交內
        // 改 config 並建立空白課表。
        // v2.13-B（已納入本檔）：課表版本號。create 必須從 1 開始；update 必須剛好是「現值 + 1」（舊文件無 version
        // 視為 0）。前端 saveSchedule() 在 transaction 內讀現值、比對讀取時的版本才寫入（schoolDataService／
        // scheduleWriteGuard）；規則層再確保「不帶版本、或以過期版本整份覆寫」的寫入（舊版頁面、console 直接
        // 呼叫）一律被拒，兩位 approver 先後編輯不會互相蓋掉（審計 logic-flow M-4）。
        // ⚠ 部署順序：先部署新前端（會寫 version），再部署本規則；舊版頁面在新規則下寫課表會被拒
        // （permission-denied），需重新整理。scripts/ 以 owner 憑證操作的腳本不受 rules 限制。
        allow create: if isApprover(schoolId)
          && isCurrentSemesterAfter(schoolId, semesterId)
          && request.resource.data.get('version', 0) == 1;
        allow update: if isApprover(schoolId)
          && isCurrentSemester(schoolId, semesterId)
          && request.resource.data.get('version', 0) == resource.data.get('version', 0) + 1;
        // 刪除：Stage 5（封存執行，RESEARCH-multitenancy-semester.md §6.2）專用——director 可
        // 刪除「非目前學期」的課表文件，供「匯出 → 驗證 → 刪除」流程使用；目前學期的課表
        // 不可被此規則刪除（防止封存流程誤刪還在使用中的課表，也避免全校教師端
        // subscribeSchedule() 因文件消失而觸發舊版 data/schedule 的 fallback 讀取，
        // 見該函式定義處的相容說明）。原本 write 規則把 create/update/delete 併成一條
        // （皆鎖 isCurrentSemester），拆開後 create/update 語意不變，delete 是本次新增的
        // 唯一新增權限，且限縮在「非目前學期」，不擴大既有攻擊面。
        allow delete: if isDirector(schoolId) && !isCurrentSemester(schoolId, semesterId);

        // ----- 課表匯入版本紀錄（v2.10）：schedules/{semesterId}/imports/{importId} -----
        // 每次匯入／還原一筆（中繼資料 + 快照）。只新增、不可改；歷史學期唯讀鎖與主文件一致。
        match /imports/{importId} {
          allow read: if canReadSchool(schoolId);
          allow create: if isApprover(schoolId) && isCurrentSemester(schoolId, semesterId);
          allow update: if false;
          // 封存清理（Stage 5）：僅 director、僅非目前學期；目前學期的紀錄不可刪。
          allow delete: if isDirector(schoolId) && !isCurrentSemester(schoolId, semesterId);
        }
      }

      // ----- 已成立調代課紀錄 -----
      match /substituteRecords/{recordId} {
        // Stage 0 R5：改為成員限定可讀（校內全員可讀維持不變，敏感欄位已私有化到
        // private/detail；教師端仍由 roleService.filterRecordsForCurrent 過濾）
        allow read: if canReadSchool(schoolId);

        // 建立：僅 approver（adminCreate 代發起 / approveRequest 核准後 runTransaction 建立）；
        // 或教師自己對自己的「自我調課」——沿用既有 writeV2Record 快速路徑，不需組長/主任審核。
        // Phase 3 資安收緊：移除原「approvedBy==自己」／「requiredApproverId==自己」教師自寫路徑——
        //   該路徑允許任一教師偽造「已核准」紀錄或冒名他人調課同意（0.5 節記錄的 blocker）。
        // 自我調課路徑同時約束「內容欄位」：type 必須是調課類且 originalTeacherId /
        //   swapTeacherId / substituteTeacherId 三者皆等於自己——封掉教師自寫
        //   type='代課' + substituteTeacher=自己 的假紀錄灌代課費
        //   （settlementCalculator 以 substituteTeacher===teacherName 且 type!=='調課' 計代課節數）。
        //   合法自我調課實際寫入（app.js buildSwapRecord + v2-app resolveApproverInfo）：
        //   type='調課'、teacherB===teacherA，三個 teacherId 欄位皆解析為本人，不受影響。
        // Stage 2（§6.1）：學期唯讀鎖——寫入的 semesterId 必須等於目前作用中的學期，
        // 歷史學期不可再新增紀錄（規則層強制，不是應用層約定）。isDeclaredLegacyWrite()
        // 豁免 legacyMigrationService 的一次性歷史資料遷移（見該函式定義處的收緊說明，
        // 阻斷 1 修復）；一般業務寫入（approver 核准／自我調課）恆屬「目前學期」，不會用到
        // 這個豁免分支。
        // 驗收修復（中 6）：`'semesterId' in request.resource.data` 顯式存在性檢查——
        // 新 rules＋舊 client（尚未部署本次 semesterId 相關改動）的過渡窗口內，舊 client
        // 送出的寫入不帶這個欄位，直接存取 `request.resource.data.semesterId` 屬於存取未
        // 定義 map key，規則語言的行為是評估錯誤（進而整條件求值失敗、視同拒絕）——顯式檢查
        // 讓「舊 client 寫入被拒」是明確、可預期的行為，不依賴語言對未定義欄位存取的隱含語意。
        // 這個窗口期間全校寫入功能（新增紀錄）會中斷，直到 client 部署完成，見
        // docs/STAGE0-DEPLOY.md「附註：Stage 2」的部署順序與公告要求。
        // v2.12（M6）：教師自我調課分支改由 isValidSelfSwapRecord() 驗證——欄位白名單
        //   （hasOnly）、型別與長度上限、禁止保留欄位 recordId／reqId 與稽核性欄位
        //   （approvedBy／approvedByName／fromRequestId／isLegacy／migratedFrom）、createdAt 不得晚於
        //   伺服器時間 1 天、affectedTeacherIds 只能是本人、姓名須與教師檔一致。這同時是前端 stored
        //   XSS（以 { recordId: d.id, ...d.data() } 展開後覆蓋 doc id、className 等欄位未跳脫）的
        //   source 端收斂。approver 分支（含 legacy 遷移）只補「禁止保留欄位 recordId／reqId」。
        // 評估順序：isDeclaredLegacyWrite 先檢查便宜的 'isLegacy' in data 再呼叫 isDirector，
        //   一般寫入不會多算一次 isDirector（規則引擎每次請求最多評估 1000 個運算式）。
        allow create: if (
            isValidSelfSwapRecord(schoolId, request.resource.data)
            || (
              isApprover(schoolId)
              && !request.resource.data.keys().hasAny(['recordId', 'reqId'])
            )
          )
          && (
            (('isLegacy' in request.resource.data) && isDeclaredLegacyWrite(schoolId, request.resource.data))
            || (
              ('semesterId' in request.resource.data)
              && canWriteSemester(schoolId, request.resource.data)
            )
          );

        // 編輯：approver；semesterId 建立後不可變（§6.1，鎖住學期歸屬本身，且變相禁止把
        // 一筆紀錄「搬到」另一個學期——不論搬去的是目前學期還是其他歷史學期）；且該筆紀錄
        // 「現在所屬的學期」必須仍是目前作用中的學期，歷史學期的紀錄整份唯讀，不能再改動
        // 其他任何欄位（阻斷 2 修復——原規則只鎖住了 semesterId 這個欄位本身不可被改，
        // 沒有鎖住「這份文件本身不可再被編輯」，等於歷史紀錄的日期/教師/節次等欄位仍可被
        // approver 任意修改，與「歷史學期唯讀」的設計意圖不符）。
        // 相容期保護：Stage 2 上線前既有的紀錄尚未跑過 semesterId 回填腳本
        // （scripts/backfill-semester-id.js）時，resource.data 沒有這個欄位——用
        // `!('semesterId' in resource.data)` 短路豁免，讓回填完成前這些舊文件仍可正常編輯
        // （行為等同 Stage 2 之前），不會因為這條新規則突然全部無法更動。回填完成、欄位
        // 存在後，「不可變 + 須為目前學期」兩項鎖定才開始生效。
        // v2.12（L6）：approver 更新時，稽核性欄位（createdAt／approvedBy／approvedByName／fromRequestId）
        //   與保留欄位（recordId／reqId）不可被改寫或新增。adminEditRecord 目前沒有任何 UI 呼叫點，
        //   正常編輯不會動到這幾個欄位。
        // v2.12b（M-3）：改為欄位白名單（原本只擋 6 個稽核欄位，其餘任意欄位／任意大小都能寫）：
        //   affectedKeys 僅限案件內容欄位 + updatedAt（updateSubstituteRecord 實際寫入的欄位；
        //   目前沒有 UI 呼叫點），合併後文件再過 hasSafeCaseText（型別／合計長度／不含 < > "）。
        //   稽核欄位（createdAt／approvedBy／approvedByName／fromRequestId）與保留欄位（recordId／
        //   reqId）因不在白名單而自然不可改。
        allow update: if isApprover(schoolId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['type', 'date', 'weekday', 'period', 'className', 'subject', 'domain', 'originalTeacher', 'substituteTeacher',
                'swapDate', 'swapWeekday', 'swapPeriod', 'swapSubject', 'swapDomain', 'swapTeacher', 'docNumber',
                'originalTeacherId', 'substituteTeacherId', 'swapTeacherId', 'updatedAt'])
          && hasSafeCaseText(request.resource.data)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
              || isRecentIsoString(request.resource.data.updatedAt))
          && (
            !('semesterId' in resource.data)
            || (
              request.resource.data.semesterId == resource.data.semesterId
              && isCurrentOrFutureSemester(schoolId, resource.data.semesterId)
              // v2.18：改 date 時，新日期推算的學期必須仍等於這筆的 semesterId（否則等於把紀錄偷偷搬到別的學期／月份）；
              // semesterId 不是標準格式的舊資料不套用。
              && (
                !request.resource.data.diff(resource.data).affectedKeys().hasAny(['date'])
                || !isStdSemester(resource.data.semesterId)
                || (isIsoDateString(request.resource.data.get('date', '')) && semesterOfDate(request.resource.data.date) == resource.data.semesterId)
              )
            )
          );

        // 刪除：director 不受限（含學期封存清理）；v2.11 起 approver（組長）亦可刪除，但僅限
        // 目前學期的紀錄——與 update 的歷史學期唯讀鎖一致，避免改動已結算學期的資料。
        // 無 semesterId 的舊紀錄比照 update 視為可刪。
        allow delete: if isDirector(schoolId)
          || (
            isApprover(schoolId)
            && (!('semesterId' in resource.data) || isCurrentOrFutureSemester(schoolId, resource.data.semesterId))
          );

        // ----- 私有明細（假別／事由）-----
        // ⚠ 非 approver 的 create 額外限制 leaveType 為調課類，理由與父文件的 isSelfSwap
        //   快速路徑同源：教師唯一能直接寫進 substituteRecords 的情境就是自我調課
        //   （leaveType 恆為 '調課'）。若不限制，教師可對「尚無 private 文件」的紀錄
        //   自行補建一份並把 leaveType 注入為公假／長期病假／喪假等不扣減假別，
        //   藉此規避月結算的授課時數扣減——與 Phase 3 封掉的「自寫代課紀錄灌代課費」同類。
        //   代課請求的假別由教師在 pendingRequests 申報、經 approver 核准後才由 approver
        //   寫入紀錄，審核才是該路徑的控制點，故不受此限。
        // v2.12（M2／L4）：
        //   - docId 鎖定為 'detail'（前端與結算只讀這一份，其他名稱只會成為濫用寫入／混淆封存匯出的垃圾）。
        //   - 非 approver 的 create 必須是「自己的自我調課」：ACL 只能是自己；且父文件不存在
        //     （前端先寫 private 再寫父文件，見 createSubstituteRecord，此時父文件尚未存在）或父文件
        //     已存在但正是本人的自我調課（isSelfSwap && originalTeacherId == 本人）。「父文件已存在且
        //     不是我的紀錄」一律拒絕——這才是審計 M2 的攻擊面（替別人沒有 private 的紀錄注入假別）。
        //     殘留風險：父文件尚不存在時無法驗證歸屬，但 recordId 是 genId 產生的不可預測 id
        //     （rec_<毫秒時間>_<7 位隨機>），攻擊者無從預先佔位。
        match /private/{docId} {
          allow read:   if hasPrivateDetailAccess(schoolId, resource.data);
          // 驗收修復（R2）：加 parentAllowsNewPrivateDetail() 擋「為歷史紀錄事後補建
          // private/detail」，見該函式定義處的完整說明。
          allow create: if docId == 'detail'
                          && isValidPrivateDetailWrite(request.resource.data)
                          && (
                            (
                              myTeacherId(schoolId) != ''
                              && request.resource.data.allowedTeacherIds.hasOnly([myTeacherId(schoolId)])
                              && request.resource.data.allowedTeacherIds.hasAll([myTeacherId(schoolId)])
                              && request.resource.data.leaveType in ['調課', 'swap']
                              && parentIsOwnSelfSwapOrAbsent(schoolId, recordId)
                            )
                            || (idList30(request.resource.data.allowedTeacherIds) && isApprover(schoolId))
                          )
                          && parentAllowsNewPrivateDetail(schoolId, recordId);
          // 驗收修復（阻斷 2）：加歷史學期唯讀鎖，見 parentSubstituteRecordCurrentSemester()。
          allow update: if docId == 'detail'
                          && isApprover(schoolId)
                          && isValidPrivateDetailWrite(request.resource.data)
                          && idList30(request.resource.data.allowedTeacherIds)
                          && parentSubstituteRecordCurrentSemester(schoolId, recordId);
          // v2.16（LF-L2）：approver 可刪（前端刪紀錄時先刪 private/detail 再刪父文件，避免假別事由孤兒）。
          // 學期鎖與父文件 delete 同款（parentAllowsNewPrivateDetail：父文件不存在＝孤兒清理、無 semesterId 舊資料、
          // 或屬目前學期才放行），歷史學期的假別事由不可被事後刪除而影響結算。director 不受限（維持原行為）。
          allow delete: if isDirector(schoolId)
                          || (docId == 'detail' && isApprover(schoolId) && parentAllowsNewPrivateDetail(schoolId, recordId));
        }
      }

      // ----- 待同意 / 待核准請求 -----
      match /pendingRequests/{reqId} {
        // Stage 0 R6：改為成員限定可讀（原「任何登入者」會讓他校待審請求被讀取）
        allow read: if canReadSchool(schoolId);

        // 建立：approver（代發，較寬但同樣不可自帶已核准欄位）；或發起人本人。
        // Phase 3 資安收緊（create 端）：發起人本人 create 必須符合狀態機初始狀態——
        //   substitute → status 只能是 pending_swap_consent，同意名單恰為代課教師（v2.20 起；原為 pending_approval）；
        //   swap / multi_swap → status 只能是 pending_swap_consent 且 pendingConsentTeacherIds 非空
        //   （封掉自帶 status='pending_approval' + 空同意名單跳過對方同意的路徑）；
        //   一律禁止 create 就自帶 approvedBy/approvedAt/approvedByName 或預填 swapConsents。
        // 欄位對齊 pendingRequestService.createRequest 實際寫入（swapConsents 固定寫入空 map）。
        // Stage 2（§6.1，超出報告明文只提到 substituteRecords 的範圍，見設計報告§6.1與本次
        // 實作 prompt 的取捨說明）：pendingRequests 的建立同樣鎖 semesterId==目前學期。
        // 相依文件 config/main 已在 isApprover()/isInitialDirector() 判斷鏈中讀過一次
        // （不論最終命中哪個分支，isApprover(schoolId) 一定會在整個 OR 表達式求值時被呼叫
        // 到，因為它是第一個要判斷的分支，內部一定會呼叫 isInitialDirector 讀 config），
        // 計費成本為 0，理由與 isCurrentSemester() 定義處相同。
        // 驗收修復（中 6）：`'semesterId' in request.resource.data` 顯式存在性檢查，理由與
        // substituteRecords create 規則同款（新 rules＋舊 client 過渡窗口的明確拒絕，不依賴
        // 未定義欄位存取的隱含語意）。
        // v2.12（M6）：兩條分支共用 isValidPendingRequestCreate() 的欄位白名單／型別／長度／
        //   requestType-type 一致／createdAt 不得為未來／姓名與 ID 一致／affectedTeacherIds 子集驗證，
        //   且一律禁止保留欄位 reqId／recordId／id 以外的非白名單欄位（hasOnly 已涵蓋）。
        // 評估順序刻意先教師分支、後 approver 分支：一般教師（絕大多數寫入）命中教師分支即短路，
        // 不必再付 isApprover 的運算式額度（規則引擎每次請求最多評估 1000 個運算式）。
        allow create: if isValidPendingRequestCreate(request.resource.data)
          && isTeacherPendingCreate(schoolId, request.resource.data)
          && ('semesterId' in request.resource.data)
          && canWriteSemester(schoolId, request.resource.data);

        // 更新：
        //  - approver：核准 / 駁回，僅能動工作流欄位（不可竄改申請內容：節次/日期/教師等，
        //    create 後即不可變）
        //  - 同意人（pendingConsentTeacherIds 內；含舊資料 requiredApproverId 相容）：
        //    同意 / 拒絕，僅能動工作流欄位；status 只能維持原值（多重調課部分同意）
        //    或轉成 pending_approval / rejected（不可越級寫成 approved）
        // Phase 3 資安收緊：兩邊都加 affectedKeys 白名單，欄位需對齊
        //   pendingRequestService 的 consentRequest / approveRequest / rejectRequest 實際寫入欄位。
        // v2.12（M1）：兩條分支都收斂成函式——
        //   isValidApproverUpdate：僅「pending_approval → approved」與「駁回」，不得動同意名單／同意紀錄，
        //     approvedBy／rejectedBy 必須是自己；
        //   isValidConsenterUpdate：同意人只能把「自己」移出名單並新增「自己」那一筆 swapConsents，
        //     名單清空 ⇔ 轉 pending_approval；拒絕時不得觸碰同意欄位。
        //   兩者都要求時間欄位（statusUpdatedAt／rejectedAt）不得為未來。
        // P4b（L-C）：兩個函式各自要近 500 個運算式，引擎不會因前者為 false 就省下後者的成本，所以
        // approver 對 pending_approval（最常見的核准／駁回）若被拒，兩者相加會撞上 1000 的上限才拒絕。
        // pending_approval 階段不存在同意人更新（isValidConsenterUpdate 只接受 pending／pending_swap_consent），
        // 用三元運算式只選一邊評估；語意與原本的 A || B 完全相同。
        allow update: if resource.data.status == 'pending_approval'
          ? isValidApproverUpdate(schoolId)
          : (isValidApproverUpdate(schoolId) || isValidConsenterUpdate(schoolId));

        // 刪除：approver；發起人；被邀請人（同意後可清掉草稿）
        // v2.12（L3）：發起人／被邀請人只能刪除「尚未結案」或「已被駁回」的申請（撤回、關閉駁回通知）；
        //   已核准（approved）的申請是審核軌跡，只有 approver 能刪。
        allow delete: if isApprover(schoolId)
          || (
            isSignedIn()
            && myTeacherId(schoolId) != ''
            && resource.data.status in ['pending', 'pending_swap_consent', 'pending_approval', 'rejected']
            && (
              resource.data.initiatedBy == myTeacherId(schoolId)
              || resource.data.get('requiredApproverId', '') == myTeacherId(schoolId)
            )
          );

        // ----- 私有明細（假別／事由，Phase 6）-----
        // Stage 5 驗收修復（中5）：create/update 補歷史學期唯讀鎖，比照 substituteRecords 側
        // 的 parentAllowsNewPrivateDetail()／parentSubstituteRecordCurrentSemester()。
        // v2.12（M2／L4）：docId 鎖定 'detail'；非 approver 的 create 還要求「父文件尚不存在
        //   （前端先寫 private 再寫父文件）或發起人就是本人」，封掉「替他人在途申請補建假別」。
        match /private/{docId} {
          allow read:   if hasPrivateDetailAccess(schoolId, resource.data);
          allow create: if docId == 'detail'
                          && isValidPrivateDetailWrite(request.resource.data)
                          && idList30(request.resource.data.allowedTeacherIds)
                          && (
                            (
                              myTeacherId(schoolId) != ''
                              && request.resource.data.allowedTeacherIds.hasAny([myTeacherId(schoolId)])
                              && parentIsOwnRequestOrAbsent(schoolId, reqId)
                            )
                            || isApprover(schoolId)
                          )
                          && parentAllowsNewPendingRequestPrivateDetail(schoolId, reqId);
          allow update: if docId == 'detail'
                          && isApprover(schoolId)
                          && isValidPrivateDetailWrite(request.resource.data)
                          && idList30(request.resource.data.allowedTeacherIds)
                          && parentPendingRequestCurrentSemester(schoolId, reqId);
          // v2.16（LF-L2）：approver，或發起人本人（限未結案或已駁回的申請，父文件必須仍存在；前端撤回／關閉駁回通知時
          // 與父文件在同一個原子寫入內一起刪）。被邀請人（requiredApproverId）不開放：前端 canCancelRequest 不給被邀請人撤回，
          // 開放只會讓代課教師悄悄刪掉待核准申請的假別明細。director 維持原行為。
          allow delete: if isDirector(schoolId)
                          || (docId == 'detail' && isApprover(schoolId))
                          || (
                            docId == 'detail'
                            && myTeacherId(schoolId) != ''
                            && exists(/databases/$(database)/documents/schools/$(schoolId)/pendingRequests/$(reqId))
                            && get(/databases/$(database)/documents/schools/$(schoolId)/pendingRequests/$(reqId)).data.status in ['pending', 'pending_swap_consent', 'pending_approval', 'rejected']
                            && get(/databases/$(database)/documents/schools/$(schoolId)/pendingRequests/$(reqId)).data.initiatedBy == myTeacherId(schoolId)
                          );
        }
      }

      // ----- 操作日誌（稽核軌跡，不可改/刪） -----
      // 讀取：approver（director + section_chief）皆可查 audit trail
      // 寫入：校內成員；欄位白名單與型別嚴格驗證
      //   欄位需對齊 operationLogger.log()：action / actor / timestamp(ISO 字串)
      //   / targetType / targetId / details(map)。
      // Stage 0 R7：改為 isMember(schoolId) 守門（原「任何登入者」允許對任一學校灌入偽造
      //   稽核軌跡，且 update/delete 恆 false＝永久污染）。login_denied 依定義發生在
      //   「使用者尚非任何學校成員」，此時 isMember 恆為 false，不可能再寫進這裡——
      //   已改道寫入 joinAttempts（見上方 match /joinAttempts/{uid} 與 §3.4b），
      //   故本規則不再需要相容「actor 各欄為 null」的 login_denied 寫入路徑。
      match /operationLogs/{logId} {
        allow read:   if isApprover(schoolId);
        // Stage 2（§5.3）：operationLogs 加 semesterId 欄位（供未來 Stage 5 封存時分批），
        // 補進欄位白名單；沒有對 semesterId 的值做進一步驗證（可以是 null，例如日誌寫入時
        // semesterState 尚未初始化的極早期時序），純供分批查詢用，不是安全關鍵欄位。
        // v2.12（M3）：改由 isValidOperationLog() 驗證——actor 必須是登入者本人（uid／teacherId／
        //   email／姓名），timestamp 為 ISO 字串且不得晚於伺服器時間 1 天（封掉 9999 年置頂），
        //   action／targetType／targetId 限制安全字元集與長度，details 限制頂層鍵數。
        //   isValidOperationLog 內的 myTeacherId != '' 已包含 isMember（有效成員）檢查。
        allow create: if isValidOperationLog(schoolId, request.resource.data);
        allow update, delete: if false;  // 稽核軌跡不可改／刪
      }

      // ----- 封存紀錄（Stage 5，RESEARCH-multitenancy-semester.md §6.2/§6.5） -----
      // schools/{schoolId}/archives/{semesterId}：director 完成「匯出 → 驗證 → 刪除」封存
      // 流程後寫入的紀錄（執行當下的各集合筆數、匯出 JSON 的 SHA-256 雜湊、執行者、時間）。
      // doc id 綁 semesterId。如實描述這份紀錄「是什麼」與「不是什麼」（驗收修復 輕11，
      // 訂正原版誇大的說法）：
      //   - 是：client 端在刪除前已核對雲端當下筆數/ID 與匯出當下一致（見 v2-app.js
      //     executeSemesterArchiveDelete 的核對邏輯），刪除本身依循了本流程規定的步驟。
      //   - 不是：不是「事後獨立稽核」的結果——寫入這筆紀錄的 director 本人就是執行刪除的人，
      //     信任層級與其他 director-only 破壞性操作（刪除任何紀錄、清除所有資料）相同（見
      //     檔頭第 6 點的信任根說明）；也不代表「使用者已把下載的 JSON 妥善備份」（純前端
      //     架構下無法驗證這件事，見 docs/STAGE5-ARCHIVE.md「已知限制」）。
      // 比照 operationLogs「稽核軌跡不可改／刪」設計：寫入後任何人（含 director）皆不可再
      // 改動或刪除。
      match /archives/{semesterId} {
        // 讀取：approver（director + section_chief）——內容含刪除操作的細節，
        // 與 operationLogs 同一敏感等級，不對一般教師開放。
        allow read: if isApprover(schoolId);
        // 建立：僅 director——封存刪除本身就是 director-only 的破壞性操作（見
        // substituteRecords/pendingRequests 的 delete 規則），寫入這筆紀錄的權限應與
        // 實際執行刪除的權限一致。欄位白名單 + 基本型別驗證，避免任意大小/形狀的資料寫入；
        // note 額外限制字數（驗收修復 輕11），避免這個唯一的自由文字欄位被灌入超長內容。
        allow create: if isDirector(schoolId)
          && request.resource.data.keys().hasOnly(['semesterId', 'archivedAt', 'archivedBy', 'counts', 'jsonHash', 'note'])
          && request.resource.data.semesterId == semesterId
          && request.resource.data.archivedAt is string
          && request.resource.data.archivedBy is map
          && request.resource.data.counts is map
          && request.resource.data.jsonHash is string
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() < 500));
        allow update, delete: if false;
      }

      // ----- Google uid → teacherId 映射 -----
      // ⚠ 安全關鍵：整套 isDirector/isApprover/myTeacherId 都信任這條映射的 linkedTeacherId，
      //   因此「自己寫自己」時必須驗證 linkedTeacherId 指向的教師檔 email == 本人登入 email，
      //   否則任一教師可把自己映射到 director 的 teacherId 而提權為主任。
      // 驗收修復 S5-R：此為首登關鍵路徑（authGuardV2.resolveIdentity 建立 mapping 靠這條
      //   規則放行），teachers.email 一律小寫儲存，用 userEmail().lower() 比對。
      match /userMappings/{uid} {
        // 自己讀自己；approver 可讀全部（核准時需要看對方身份）
        allow read: if isSignedIn() && (request.auth.uid == uid || isApprover(schoolId));

        // director 可代寫（補綁定，linkedTeacherId 不受限）；
        // 自己 upsert 自己（authGuardV2 登入完成寫入）：linkedTeacherId 必須指向
        //   email 等於本人登入 email 的教師檔（只能映射到自己，杜絕提權）。
        // v2.12（H1）：自建分支加 isEmailVerified()（未驗證的搶註帳號不可自建 mapping）與
        //   isValidSelfMapping()（欄位白名單 + 長度上限 + 教師檔存在且 email 相符）。
        allow create, update: if isDirector(schoolId)
          || (
            isEmailVerified()
            && request.auth.uid == uid
            && isValidSelfMapping(schoolId, request.resource.data)
          );

        // 刪除：只有 director
        allow delete: if isDirector(schoolId);
      }
    }

    // ================ Stage 3：頂層 userDirectory（uid → schoolId 反查） ================
    // 見檔頭第 8 點。schools/{schoolId} 之外的頂層集合，不依賴任何 schoolId 路徑參數，
    // 純粹以 request.auth.uid 為 key，供 authGuardV2.resolveIdentity() 在還不知道
    // schoolId 之前就能讀到自己屬於哪所學校。
    match /userDirectory/{uid} {
      // 讀取：僅本人。之後才會走 schools/{schoolId}/... 底下依 isMember 等機制判斷的既有規則，
      // 這裡不需要、也不應該對外開放任何人查任何人屬於哪所學校。
      allow read: if isSignedIn() && request.auth.uid == uid;

      // 建立/更新：僅本人，且 schoolId 必須指向一所「存在」的學校（configExists，防止指向
      // 不存在的 schoolId——若不擋，之後 getActiveSchoolId() 會被設成一個永遠讀不到 config
      // 的值，等同把自己鎖進一個死路徑；也防止被用來當作任意字串的免費寫入端點探測）。
      // 欄位白名單 schoolId/createdAt，型別驗證。
      // ⚠ schoolId 格式驗證（Stage 3 opus 驗收 輕6，訂正原版負面檢查的繞過漏洞）：
      // configExists() 內部把這個值原文拼進 `schools/$(schoolId)/config/main` 這個路徑模板，
      // 值本身若含 '/' 會多插入路徑段，使解析出的路徑段數偏離「文件路徑必為偶數段」的規則。
      // 原版用負面檢查 `!schoolId.matches('.*/.*')` 想擋含 '/' 的值，但 Firestore 規則的
      // `.matches()` 是 RE2 引擎、且是全字串匹配（比照 Python re.fullmatch）；RE2 的 `.`
      // 預設不匹配換行字元 `\n`，若 schoolId 裡同時含 `\n` 與 `/`（例如 `"inhu\n/x"`），
      // `.*` 無法跨過 `\n` 去匹配到後面的 `/`，導致整串「找不到符合 `.*/.*` 的完整匹配」，
      // `.matches('.*/.*')` 回傳 false，`!false` 變成 true——負面檢查被繞過，即使字串裡
      // 明明含有 `/`。改為正面白名單 `matches('^[a-z0-9_-]{1,50}$')`（只允許小寫英數字、底線、
      // 連字號，長度 1-50）：白名單只列出「允許什麼」，不會有「忘記擋什麼」的繞過空間，且與
      // 現行唯一的 schoolId 值 `'inhu'` 及未來預期的 slug 風格命名一致。
      // opus 重驗 5：明確加上 `^`/`$` 錨點——雖然 Firestore 規則文件說明 `.matches()` 本身即為
      // 全字串匹配（比照 Python re.fullmatch，理論上不加錨點也不會有子字串繞過），但明確寫出
      // 錨點不依賴這個「文件說隱含全字串匹配」的間接保證，直接在規則本文表達「整段字串必須從
      // 頭到尾都符合」的意圖，可讀性與防禦力都更高，成本是零（不影響任何合法的 schoolId 值）。
      // Stage 4：補上 Stage 3 刻意留白的 email_verified 檢查（見上方原本的留白說明，
      // 現已改寫如下）——自寫分支要求 isEmailVerified()；新增 platformAdmin 分支供核准
      // 申請時代寫申請人的 userDirectory（申請人此刻可能尚未重新登入，無法靠自寫分支完成；
      // 不要求 email_verified，因為申請人 email 已在 schoolApplications 的 create 規則驗證
      // 過一次，見該 match 區塊）。
      // 相容性：現有 inhu 使用者的 userDirectory 已由 scripts/backfill-user-directory.js
      // 離線建立（不受 client 規則限制，見該腳本檔頭），這條規則只影響「文件尚不存在，
      // 需要靠這條自寫規則首次建立」的使用者——已回填過的既有成員這輩子不會再走到這個分支
      // （見 authGuardV2.resolveIdentity 的 `if (!userDirectoryExisted)` 守門），故本次收緊
      // 不影響任何現有 inhu 使用者的登入。
      // ⚠ 權限面誠實揭露（platformAdmin 分支）：允許 platformAdmin 寫入「任意」uid 的
      // userDirectory（不限於申請中的那一位），只要目標 schoolId 存在。理論上可被用來把
      // 既有教師的 userDirectory 指向另一所學校，但不構成帳號接管——目標學校仍需要獨立的
      // teachers/emailIndex 配對，該使用者下次登入若配對不到，只會被導向 Stage 4 的申請
      // 流程（見 authGuardV2.resolveIdentity 的 no_teacher_match 分支），不會被授予任何角色。
      // 這是 platformAdmin 作為唯一信任錨點本來就該承擔的風險層級，與 director 可代寫校內
      // 任何 userMappings（linkedTeacherId 不受限）是同一信任模型，非本次新增的獨立破口。
      allow create, update: if (
          (isSignedIn() && request.auth.uid == uid && isEmailVerified())
          || isPlatformAdmin()
        )
        && request.resource.data.keys().hasOnly(['schoolId', 'createdAt'])
        && request.resource.data.schoolId is string
        && request.resource.data.schoolId.matches('^[a-z0-9_-]{1,50}$')
        && configExists(request.resource.data.schoolId)
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;

      // 刪除：僅本人。目前 client 沒有任何路徑會呼叫刪除，保留給本人自行清空的彈性
      // （例如未來允許使用者主動「離開學校」）不構成額外風險——能刪的永遠只是自己那一份，
      // 刪除後下次登入會重新走 resolveSchoolIdForUid() 的 fallback，不影響其他任何人。
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ================ Stage 4：頂層 platformAdmins（跨校信任錨點） ================
    // 見檔頭第 9 點與 isPlatformAdmin() 定義處。完全禁止 client 寫入——這是整套 Stage 4
    // 設計唯一沒有 client 路徑可寫的集合，只能由開發者以 gcloud/REST 個人帳號離線寫入
    // （scripts/bootstrap-platform-admin.js，只寫不執行，需人工確認 --dry-run 輸出後才能
    // 拿掉旗標執行），與報告 §4.3「platformAdmins 集合完全禁止 client 寫入」的設計一致。
    match /platformAdmins/{uid} {
      // 讀取：僅本人（供 client 端自我判斷「我是不是 platformAdmin」以決定是否渲染審核頁，
      // 不對外開放任何人查任何人是否為 platformAdmin）。
      allow read:  if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ================ Stage 4：頂層 schoolDirectory（公開學校名錄） ================
    // 見檔頭第 9 點。僅 schoolName/createdAt 兩個公開欄位，供申請頁檢查 schoolId 是否已被
    // 使用（比探測 schools/{schoolId}/config 是否存在更正當——config 的 read 規則本身就是
    // 拒絕任意登入者探測的對象，見 R1/R2）。
    match /schoolDirectory/{schoolId} {
      // 讀取：opus 驗收 M1，原本用 `allow read`（＝ get + list）一次放行——但這個集合的
      // 「加入既有學校」流程（見 v2-app.js 的 join 流程與 authGuardV2 B1 修復）只需要查
      // 「某一個已知代碼是否存在」，不需要列出全部學校名單；開放 `list` 等於讓任何登入者
      // 一次撈走全平台所有學校的名稱與建立時間，多此一舉的資訊暴露面。拆成：
      //   - get：任何登入者可查單一已知 schoolId（申請頁查重、加入流程查代碼皆走這條）。
      //   - list：僅 platformAdmin（例如未來若要做「列出所有學校」的管理功能）。
      allow get:  if isSignedIn();
      allow list: if isPlatformAdmin();
      // 寫入：僅 platformAdmin，且僅 create（schoolDirectory 本身仍是 create-only：
      // 一旦某個 schoolId 已被使用，這筆寫入會被 Firestore 判定為 update 而非 create，
      // 本規則不涵蓋 update，天然拒絕「用同一個 schoolId 二次核准」；config/main 則已不再有此保護，見第 18 點）。不開放 update：校名
      // 一旦公告不應被悄悄改掉，真要改名屬於例外情況，留給開發者離線處理；不開放 delete
      // 避免 schoolId 這個「一旦用過就永久佔用」的槽位被騰出來給另一所學校重複使用（沿用中
      // 的 userDirectory/teachers 等資料仍會指向舊的 schoolId，delete 後產生的混淆遠大於好處）。
      allow create: if isPlatformAdmin()
        && request.resource.data.keys().hasOnly(['schoolName', 'createdAt'])
        && request.resource.data.schoolName is string
        && request.resource.data.schoolName.size() > 0 && request.resource.data.schoolName.size() < 100
        && request.resource.data.createdAt is string;
      allow update, delete: if false;
    }

    // ================ Stage 4：頂層 schoolApplications（開通新學校申請） ================
    // 見檔頭第 9 點／RESEARCH-multitenancy-semester.md §4.4 變體 B（自助申請 + 平台管理者
    // 輕量審核）。doc id 綁申請人 uid——「一人一申請」與 joinAttempts（§3.4b）同一設計：
    // doc id 本身就是天然的去重鍵，不需要額外查詢或計數器。
    match /schoolApplications/{uid} {
      // 讀取：本人（查自己的申請狀態）或 platformAdmin（審核列表）。
      allow read: if isSignedIn() && (request.auth.uid == uid || isPlatformAdmin());

      // 建立：首次申請。要求 isEmailVerified()——這是本階段唯一「任意登入者皆可觸發」的
      // 開放寫入端點（不像 userDirectory 的自寫分支只在既有機制已判定登入合法之後才被呼叫，
      // 見檔頭第 8 點的對照說明），必須擋掉未驗證的 email，理由與報告 §4.1「強制 email
      // 驗證」一致。欄位白名單 + 型別/長度驗證；status 建立當下必須是 'pending'；
      // applicantUid/applicantEmail 必須等於本人，防止代人申請或塞入偽造的聯絡資訊。
      allow create: if isSignedIn() && request.auth.uid == uid
        && isEmailVerified()
        && request.resource.data.keys().hasOnly([
             'schoolName', 'applicantEmail', 'applicantUid', 'desiredSchoolId',
             'status', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.applicantUid == uid
        && request.resource.data.applicantEmail == userEmail().lower()
        && request.resource.data.schoolName is string
        && request.resource.data.schoolName.size() > 0 && request.resource.data.schoolName.size() < 100
        && request.resource.data.desiredSchoolId is string
        && request.resource.data.desiredSchoolId.matches('^[a-z0-9_-]{1,50}$')
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;

      // 更新：兩種情境，皆不可越權竄改對方負責的欄位——
      //   (a) platformAdmin 審核：狀態機兩條合法轉移路徑——
      //       (a-1) 'pending' → 'approved'/'rejected'：正常審核。
      //       (a-2) 'approved' → 'rejected'（opus 驗收 H2 新增，解套路徑）：核准流程若卡在
      //             「schoolDirectory 已有同代碼同名紀錄」的死局（見
      //             schoolApplicationService.js 的 SameNameConflictError／approveApplication
      //             檔頭說明），或核准後才發現需要撤銷，platformAdmin 可把已核准的申請改回
      //             駁回狀態，讓申請人得以重新申請（走下面 (b) 分支換一個代碼）。⚠ 這個
      //             分支**不會**復原已經建立的學校資料（config/schoolDirectory）——那些
      //             寫入（schoolDirectory 是 create-only 無刪除路徑；config/main 在未確立 directorEstablished 前 platformAdmin 以主任身分可刪，v2.17）；需要的話得靠開發者
      //             離線用 gcloud/REST 清理，見 docs/STAGE4-DEPLOY.md「已知限制」。
      //       兩條路徑皆只能動流程欄位（status/updatedAt/reviewedAt/reviewedBy/
      //       rejectReason），不能改申請人填寫的內容（schoolName/desiredSchoolId 等）——
      //       避免審核者順手「校正」申請內容卻沒有留下申請人知情的軌跡；reviewedAt/
      //       reviewedBy/rejectReason 三個選填欄位另外驗證型別/長度（見
      //       isValidSchoolApplicationReviewFields()，opus 驗收 L3）。
      //   (b) 申請人本人在被駁回後重新申請：僅在目前狀態是 'rejected' 時，把整份申請內容
      //       連同 status 重設為 'pending'（等同重新提交），驗證同 create，唯一差異是
      //       `createdAt` 必須與既有值相同（opus 驗收 L4：鎖住「送出時間」不可被重新申請
      //       洗掉，語意上代表第一次申請的時間，不是「最近一次」）。pending 期間本人不能再
      //       update（此時本人分支的 `resource.data.status == 'rejected'` 前提不成立，只有
      //       platformAdmin 的分支可能命中）——這正是「pending 期間不可重複」的實際落地
      //       方式：doc id 已綁 uid（無法用 create 建第二份），pending 狀態下本人也無法用
      //       update 繞過（唯一能動狀態的是 platformAdmin）。
      allow update: if (
          isPlatformAdmin()
          && (
            (resource.data.status == 'pending' && request.resource.data.status in ['approved', 'rejected'])
            || (resource.data.status == 'approved' && request.resource.data.status == 'rejected')
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'updatedAt', 'reviewedAt', 'reviewedBy', 'rejectReason'
             ])
          && isValidSchoolApplicationReviewFields(request.resource.data)
        )
        || (
          isSignedIn() && request.auth.uid == uid
          && isEmailVerified()
          && resource.data.status == 'rejected'
          && request.resource.data.keys().hasOnly([
               'schoolName', 'applicantEmail', 'applicantUid', 'desiredSchoolId',
               'status', 'createdAt', 'updatedAt'
             ])
          && request.resource.data.applicantUid == uid
          && request.resource.data.applicantEmail == userEmail().lower()
          && request.resource.data.schoolName is string
          && request.resource.data.schoolName.size() > 0 && request.resource.data.schoolName.size() < 100
          && request.resource.data.desiredSchoolId is string
          && request.resource.data.desiredSchoolId.matches('^[a-z0-9_-]{1,50}$')
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt is string
        );

      // 刪除：不開放。核准/駁回都是永久記錄（比照 operationLogs/archives 的稽核精神），
      // 駁回後的重新申請走上面的 update 分支，不需要刪除重建。
      allow delete: if false;
    }

    // ================ 穩定版 master：保留原規則 ================
    // users/{uid}/... 由本人讀寫，與 V2 完全分離
    // v2.12（M4）：原本是 users/{uid}/{document=**} 遞迴萬用字元——任何自行註冊的帳號都能在自己的子樹
    // 無限寫入任意大小的文件（帳單攻擊 → 觸發 kill switch → 全校停擺）。V1 個人雲端備份實際只使用
    // 單一文件 users/{uid}/data/substituteSystem（cloudSyncService.getUserDocPath；legacyMigrationService
    // 讀取同一路徑），故收斂成這一個確切路徑：
    //   - 讀取／刪除：本人（V1 備份讀取、V2 的「清除資料」刪除本人備份、遷移偵測都用得到）。
    //   - 建立／更新：本人 + email 已驗證 + 欄位白名單與大小約束（isValidV1Backup）。
    // 其他任何 users/** 路徑一律拒絕。
    match /users/{uid}/data/substituteSystem {
      allow read, delete: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid
                            && isEmailVerified()
                            && isValidV1Backup(request.resource.data);
    }
  }
}
